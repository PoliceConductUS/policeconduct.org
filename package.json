{
  "name": "policeconduct.org",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "audit": "npm run audit:seo && npm run audit:a11y",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "build": "node scripts/validate-build-env.mjs && node scripts/validate-schema-contract.mjs && node scripts/generate-icon-sprite.mjs && node scripts/refresh-build-projections.mjs && GIT_COMMIT_SHA=${GIT_COMMIT_SHA:-$(git rev-parse --short=12 HEAD)} GIT_COMMIT_DIRTY=${GIT_COMMIT_DIRTY:-$(if git diff --quiet HEAD -- && [ -z \"$(git ls-files --others --exclude-standard)\" ]; then echo 0; else echo 1; fi)} astro build && npm run build:search-index && npm run validate:no-inline-css && node scripts/generate-redirect-map.mjs && npm run purge:css && npm run validate:css",
    "build:search-index": "npx pagefind --site dist",
    "purge:css": "node --max-old-space-size=12288 scripts/purge-built-css.mjs",
    "deploy:preview": "bash scripts/deploy-preview.sh",
    "deploy:prod": "bash scripts/deploy-incremental.sh",
    "dev": "node scripts/dev.mjs",
    "doctor": "bash scripts/bootstrap-dev.sh --check",
    "enrich:agency-coordinates": "node scripts/enrich-missing-agency-coordinates.mjs",
    "format": "npm run format:prettier && npm run format:sql",
    "format:check": "prettier --check .",
    "format:prettier": "prettier --write .",
    "format:sql": "mise exec -- uvx sqlfluff==4.1.0 format --dialect postgres --processes 1 --disable-progress-bar .",
    "geocode:agencies": "node scripts/geocode-agency-locations.mjs",
    "lint": "npm run lint:es && npm run lint:sql",
    "lint:es": "eslint .",
    "lint:sql": "mise exec -- uvx sqlfluff==4.1.0 lint --dialect postgres --processes 1 --disable-progress-bar .",
    "ocr": "ocr",
    "openspec": "openspec",
    "openspec:status": "node scripts/openspec-status.mjs",
    "preview": "astro preview",
    "refresh:build-projections": "node scripts/refresh-build-projections.mjs",
    "report:coverage": "node scripts/coverage-report.mjs",
    "review": "ocr review --audience agent --from main --to HEAD",
    "review:workspace": "ocr review --audience agent",
    "scan:personal-data": "node scripts/scan-personal-data.mjs --tracked",
    "setup": "bash scripts/bootstrap-dev.sh",
    "test:client": "node --test scripts/copy-link.test.mjs",
    "test": "npm run test:client && npm run test:redirects && npm run test:media && npm run test:lambda && npm run test:css && npm run test:personal-data && npm run test:coverage && npm run test:e2e",
    "test:coverage": "node --test \"src/lib/coverage/*.test.mjs\"",
    "test:css": "node --test scripts/purge-built-css.test.mjs",
    "test:media": "node --test scripts/video.test.mjs scripts/personnel-photos.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:personal-data": "node --test scripts/scan-personal-data.test.mjs",
    "test:redirects": "node --test scripts/verify-redirect-coverage.test.mjs scripts/cloudfront-router.test.mjs scripts/load-redirects.test.mjs scripts/generate-redirect-map.test.mjs scripts/deploy-release-guard.test.mjs",
    "update:deps": "node scripts/update-dependencies.mjs --root .",
    "update:deps:all": "node scripts/update-dependencies.mjs --all",
    "validate": "npm run format:check && npm run lint && npm run validate:types && npm run validate:shell && npm run validate:schema && npm run validate:openspec && npm run scan:personal-data && npm run test",
    "validate:css": "node scripts/validate-critical-css.mjs",
    "validate:no-inline-css": "node scripts/validate-no-inline-css.mjs",
    "validate:openspec": "openspec validate --all",
    "validate:redirects": "node scripts/verify-redirect-coverage.mjs",
    "validate:schema": "node scripts/validate-schema-contract.mjs",
    "validate:shell": "bash -n .githooks/* scripts/*.sh infrastructure/bootstrap-*/*.sh infrastructure/bootstrap-*/scripts/*.sh",
    "validate:types": "astro check",
    "deploy:preview:sync": "bash scripts/deploy-preview-sync.sh",
    "test:lambda": "npm --prefix infrastructure/bootstrap-policeconduct/lambdas/forms-api ci --omit=dev --no-audit --no-fund && node --test infrastructure/bootstrap-policeconduct/lambdas/forms-api/index.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/public-sans": "^5.3.0",
    "@sentry/astro": "^11.9.0",
    "aos": "^2.3.4",
    "astro": "^7.4.2",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.9",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "^1.13.3",
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "1.15.0",
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "supabase": "2.121.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "purgecss": {
      "postcss-selector-parser": "7.1.7"
    }
  },
  "allowScripts": {
    "@alibaba-group/open-code-review@1.13.2": true,
    "fsevents@2.3.3": true
  }
}
