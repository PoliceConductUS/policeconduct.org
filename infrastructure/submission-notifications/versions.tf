terraform {
  required_version = ">= 1.11.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # Existing state for notification resources and the approved monitor removal.
  backend "s3" {
    bucket       = "policeconduct-tfstate-942370948729"
    key          = "submission-notifications/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}

provider "aws" {
  region = var.aws_region
}
