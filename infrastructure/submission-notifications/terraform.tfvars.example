# infrastructure/submission-notifications
#
# Copy to terraform.tfvars and fill in. There are no defaults for the three
# values that are decisions rather than settings: who is told, who is told when
# that breaks, and the reconciliation cutoff.

# Who is told a submission arrived.
# Board decision 2026-10-25: hello@policeconduct.org only.
#
# This is a shared mailbox in a Google Workspace tenant IPC does not own
# (INS-55). It is confirmed monitored (INS-16 §14), and the SNS confirmation
# click will prove it independently — an unconfirmed subscription reads as
# PendingConfirmation and receives nothing. If it ever stops being read, the
# canary below is what notices.
submission_notification_recipients = ["hello@policeconduct.org"]

# Who is told the notification path itself is broken.
# Board decision 2026-10-25: dlotts@knightrider.com.
#
# Different mailbox and different domain from the line above, on purpose. A
# Workspace tenant failure takes every policeconduct.org address at once, so an
# alert sent there would die with the thing it is reporting.
notification_canary_alert_endpoints = ["dlotts@knightrider.com"]

# Set to the date this stack is first applied. Submissions stored before it have
# no notification receipt and never will; they are INS-16 backlog, not a
# monitoring signal.
notification_receipts_since = "2026-10-25"

# Verified sender for the canary delivery probe. Must match the identity the
# submitter verification mail already uses -- read from the live Lambda, not
# guessed:
#   aws lambda get-function-configuration \
#     --function-name policeconduct-forms-api-prod \
#     --query 'Environment.Variables.EMAIL_VERIFICATION_FROM_ADDRESS' --output text
notification_from_address = "noreply@mail.policeconduct.org"

# Resend API key. Do NOT commit the filled-in file.
# Read it from the live forms API Lambda rather than keeping a second copy:
#   aws lambda get-function-configuration \
#     --function-name policeconduct-forms-api-prod \
#     --query 'Environment.Variables.RESEND_API_KEY' --output text
resend_api_key = "re_..."
