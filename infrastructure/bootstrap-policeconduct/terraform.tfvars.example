project_name = "policeconduct"
aws_region   = "us-east-1"
domain_name  = "policeconduct.org"

github_org  = "PoliceConductUS"
github_repo = "policeconduct.org"
role_name   = "policeconduct-github-actions"

state_bucket_force_destroy   = false
preview_bucket_force_destroy = false
site_bucket_force_destroy    = false
forms_drafts_bucket_force_destroy      = false
forms_submissions_bucket_force_destroy = false
forms_drafts_preview_bucket_force_destroy      = false
forms_submissions_preview_bucket_force_destroy = false
forms_draft_active_window_seconds      = 3600
forms_draft_max_bytes                  = 1048576
forms_email_verification_domain        = "mail.policeconduct.org"
forms_email_verification_from_address  = "noreply@mail.policeconduct.org"
forms_email_mail_from_subdomain        = "bounce"
forms_email_dmarc_policy               = "none"
forms_email_dmarc_aggregate_report_address = "dmarc@policeconduct.org"
site_rate_limit_per_5m                 = 3000
forms_api_rate_limit_per_5m            = 500
forms_api_alarm_5xx_threshold          = 10
forms_api_alarm_latency_p95_ms_threshold = 2000
forms_lambda_alarm_throttles_threshold   = 1
lambda_nodejs_runtime                    = "nodejs22.x"
recaptcha_min_score                      = 0.5
alarm_actions                            = []
alert_topic_name                         = "policeconduct-alerts"
alert_email_endpoints                    = []
# Who gets told a submission arrived (INS-35). At least one of these has to be
# a mailbox someone reads within 5 business days -- that is the DSAR
# acknowledgement commitment in INS-16. This list only populates the forms API
# Lambda environment; the SNS topic and its subscriptions are owned by
# infrastructure/submission-notifications. Keep the two in step.
submission_notification_email_endpoints  = ["hello@policeconduct.org"]
# From the submission_notifications_topic_arn output of
# infrastructure/submission-notifications. Empty means the forms API has no
# topic to publish to, which is the pre-INS-35 state.
submission_notifications_topic_arn       = ""
# Date the notification path went live. Submissions older than this have no
# receipt and never will; see the variable description.
notification_receipts_since              = ""
enable_site_bucket_versioning = true
ga_measurement_id_production = null
ga_measurement_id_preview    = null
sentry_dsn_production        = null
sentry_dsn_preview           = null
sentry_org                          = null
sentry_project                      = null
sentry_auth_token                   = null


extra_dns_records = [
  {
    name = "@"
    type = "MX"
    ttl  = 3600
    records = [
      "1 smtp.google.com."
    ]
  },
  {
    name = "xdvktfq76yak"
    type = "CNAME"
    ttl  = 3600
    records = [
      "gv-wvopyga6fjhcn2.dv.googlehosted.com."
    ]
  }
]

tags = {
  Project   = "policeconduct.org"
  ManagedBy = "Terraform"
  Stack     = "bootstrap"
}
