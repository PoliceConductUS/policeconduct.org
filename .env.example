# Machine settings only. Copy to .env (git-ignored).
# Secrets live in AWS Systems Manager Parameter Store under /policeconduct/secrets/.
# Deployed resource names come from Terraform outputs at run time.

# AWS profile for the account that holds the Terraform state and the secrets.
AWS_PROFILE=

DATABASE_URL=postgres://user:password@host:5432/database

PUBLIC_GA_MEASUREMENT_ID=G-##########
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=production

# Intake workspace containing assets/PersonnelPhoto and its matching imported database records.
# Required when the database has personnel_photo associations.
# Optional redirects.json in this workspace maps old URL paths to built destination paths.
INTAKE_WORKSPACE=
