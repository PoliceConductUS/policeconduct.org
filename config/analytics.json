  "unmarkedKeyEvents": ["form_submit_success"],
  "eventCreateRules": [
    {
      "destinationEvent": "report_submitted",
      "eventConditions": [
        {
          "field": "event_name",
          "comparisonType": "EQUALS",
          "value": "form_submit_success"
        },
        {
          "field": "form_name",
          "comparisonType": "EQUALS",
          "value": "reportNew"
        }
      ],
      "sourceCopyParameters": true,
      "parameterMutations": []
    },
    {
      "destinationEvent": "volunteer_submitted",
      "eventConditions": [
        {
          "field": "event_name",
          "comparisonType": "EQUALS",
          "value": "form_submit_success"
        },
        {
          "field": "form_name",
          "comparisonType": "EQUALS",
          "value": "volunteer"
        }
      ],
      "sourceCopyParameters": true,
      "parameterMutations": []
    }
  ],
  "dataRetentionSettings": {
