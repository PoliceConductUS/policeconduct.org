---
import "#src/styles/theme.css";
import GoogleAnalytics from "#src/components/GoogleAnalytics.astro";
import MastheadSearch from "#src/components/MastheadSearch.astro";
import {
  ORG_ADDRESS,
  ORG_EIN,
  ORG_LEGAL_NAME,
  ORG_SOCIAL_LINKS,
} from "#src/lib/org.js";

const {
  title,
  description,
  pagePath,
  canonicalUrl,
  robots,
  structuredData,
  socialImage,
} = Astro.props;
const resolvedPath = pagePath || Astro.url?.pathname || "/";
const issueMessage = `Issue reported from: ${resolvedPath}`;
const siteOrigin = (() => {
  const envSite = (process.env.SITE_URL || "").trim();
  if (envSite) {
    try {
      return new URL(envSite).toString();
    } catch (_error) {
      // Fall back to configured site URL.
    }
  }
  if (Astro.site) {
    return Astro.site.toString();
  }
  return "https://www.policeconduct.org/";
})();
const canonicalSource = canonicalUrl || resolvedPath;
const canonicalHref = (() => {
  try {
    return new URL(canonicalSource, siteOrigin).toString();
  } catch (_error) {
    return new URL(resolvedPath, siteOrigin).toString();
  }
})();
const socialImagePath = socialImage || "/img/webp/usa-1778524_1280.webp";
const socialImageUrl = (() => {
  try {
    return new URL(socialImagePath, siteOrigin).toString();
  } catch (_error) {
    return new URL("/img/webp/usa-1778524_1280.webp", siteOrigin).toString();
  }
})();
const robotsContent = robots || "index,follow";
const structuredDataEntries = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const serializeStructuredData = (value: unknown) =>
  JSON.stringify(value).replace(/</g, "\\u003c");
---

<!doctype html>
<html class="h-100" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,shrink-to-fit=no"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/img/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/img/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/img/favicon-16x16.png"
    />
    <link rel="icon" type="image/png" sizes="96x96" href="/img/favicon.ico" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {description ? <meta name="description" content={description} /> : null}
    <meta name="robots" content={robotsContent} />
    <meta name="author" content={ORG_LEGAL_NAME} />
    {title ? <meta property="og:title" content={title} /> : null}
    {
      description ? (
        <meta property="og:description" content={description} />
      ) : null
    }
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:site_name" content="PoliceConduct.org" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="PoliceConduct.org overview" />
    <meta name="twitter:card" content="summary_large_image" />
    {title ? <meta name="twitter:title" content={title} /> : null}
    {
      description ? (
        <meta name="twitter:description" content={description} />
      ) : null
    }
    <meta name="twitter:image" content={socialImageUrl} />

    <meta name="HandheldFriendly" content="true" />
    {
      structuredDataEntries.length
        ? structuredDataEntries.map((entry) => (
            <script
              type="application/ld+json"
              set:html={serializeStructuredData(entry)}
              is:inline
            />
          ))
        : null
    }
    <title>{title}</title>
    <GoogleAnalytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="masthead" data-pagefind-ignore>
      <div class="container">
        <a class="masthead-mark" href="/">Police<span>Conduct</span>.org</a>
        <MastheadSearch />
        <nav class="masthead-nav" aria-label="Primary">
          <a class="masthead-nav-link" href="/news/">News</a>
          <a class="masthead-nav-link" href="/donate/">Donate</a>
          <a class="nav-action nav-action-share" href="/report/new/">
            Share an experience
          </a>
          <a class="nav-action nav-action-volunteer" href="/volunteer/">
            Volunteer
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-top mt-auto d-print-none" data-pagefind-ignore>
      <div class="container py-5">
        <div
          class="d-flex justify-content-center align-items-center gap-4 mb-4"
        >
          {
            ORG_SOCIAL_LINKS.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted"
              >
                <svg width="24" height="24" aria-hidden="true">
                  <use href={`/icons.svg#${social.iconId}`} />
                </svg>
                <span class="visually-hidden">{social.label}</span>
              </a>
            ))
          }
        </div>
        <div class="row g-4 mb-4">
          <div class="col-12 col-md">
            <h3 class="ipc-subsection-title mb-3">About</h3>
            <ul class="list-unstyled text-muted mb-0">
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/about"
                  >About Us</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/about/financial-reports">Financial Reports</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/about/board"
                  >Board of Directors</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/about/contact"
                  >Contact Us</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/news/">News</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/donate/"
                  >Donate</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/volunteer/"
                  >Volunteer</a
                >
              </li>
            </ul>
            <p class="text-muted small mt-3 mb-0">
              The Institute for Police Conduct, Inc is a 501(c)(3) nonprofit
              organization dedicated to advancing transparency, accountability,
              and public trust in policing.
            </p>
            <p class="text-muted small mt-2 mb-0">
              Status: IRS determination approved - nonprofit designation is
              active.
            </p>
            <p class="text-muted small mt-2 mb-0">
              Donations are tax-deductible to the fullest extent permitted by
              law.
            </p>
            <p class="text-muted small mt-2 mb-0">
              Federal Tax ID (EIN): {ORG_EIN}
            </p>
          </div>
          <div class="col-12 col-md">
            <h3 class="ipc-subsection-title mb-3">Data &amp; Methods</h3>
            <ul class="list-unstyled text-muted mb-0">
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/data-and-methods/">Data and Methods</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/find-records/"
                  >Find Records</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/civil-cases/"
                  >Civil Cases</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/frequently-asked-questions/">FAQ</a
                >
              </li>
            </ul>
          </div>
          <div class="col-12 col-md">
            <h3 class="ipc-subsection-title mb-3">Partner</h3>
            <ul class="list-unstyled text-muted mb-0">
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/partner/academic">Academic / Research Institutions</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/partner/law-firm">Law Firm</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/partner/media"
                  >Media and Journalism</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/partner/nonprofit">Non profit / Advocacy Group</a
                >
              </li>
            </ul>
          </div>
          <div class="col-12 col-md">
            <h3 class="ipc-subsection-title mb-3">Support</h3>
            <ul class="list-unstyled text-muted mb-0">
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="#report-issue"
                  data-issue-message={issueMessage}>Report a site issue</a
                >
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/help-center"
                  >Help Center</a
                >
              </li>

              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/frequently-asked-questions/"
                >
                  FAQ
                </a>
              </li>
              <li class="mb-2">
                <a class="text-muted text-decoration-none" href="/status/">
                  Check submission status
                </a>
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="https://www.section1983.org"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Section1983.org (external link, opens in a new tab)"
                >
                  Section1983.org (external)
                </a>
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="https://free.law/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Free Law Project (external link, opens in a new tab)"
                >
                  Free Law Project (external)
                </a>
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="https://www.courtlistener.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="CourtListener (external link, opens in a new tab)"
                >
                  CourtListener (external)
                </a>
              </li>
            </ul>
          </div>
          <div class="col-12 col-md">
            <h3 class="ipc-subsection-title mb-3">Legal Notices</h3>
            <ul class="list-unstyled text-muted mb-0">
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/acceptable-use">Acceptable Use Policy</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/community-guidelines"
                  >Community Guidelines</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/cookie">Cookie Policy</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/data-subject-access-request"
                  >Data Subject Access Request</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/disclaimer">Disclaimer Policy</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/eula">End User License Agreement</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/privacy">Privacy Policy</a
                >
              </li>
              <li class="mb-2">
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/refund">Refund Policy</a
                >
              </li>
              <li>
                <a
                  class="text-muted text-decoration-none"
                  href="/legal-notice/terms-of-service">Terms of Service</a
                >
              </li>
            </ul>
          </div>
        </div>
        <div class="text-center text-muted small">
          <p class="mb-1">
            All information on this site is compiled from public records and
            community submitted information. Information is deemed reliable but
            is not guaranteed.
          </p>
          <p class="mb-1">
            Connections between records &mdash; the personnel, agencies, civil
            cases, and news coverage shown as linked to one another &mdash; are
            computer-generated, not human-verified, and may be incorrect. Verify
            these connections independently before relying on them; do not treat
            them as established fact. See our{" "}
            <a
              class="text-muted text-decoration-underline"
              href="/legal-notice/terms-of-service">Terms of Service</a
            >.
          </p>
          <p class="mb-1">{ORG_LEGAL_NAME}</p>
          <p class="mb-1">{ORG_ADDRESS.streetAddress}</p>
          <p class="mb-1">
            {ORG_ADDRESS.addressLocality}, {ORG_ADDRESS.addressRegion}{" "}
            {ORG_ADDRESS.postalCode}, United States
          </p>
          <p class="mb-1">
            <a
              class="text-muted text-decoration-none"
              href="/about/contact/"
              data-issue-message={issueMessage}>Report issue</a
            >
          </p>
          <p class="mb-0">
            © 2026 {ORG_LEGAL_NAME} All rights reserved.
          </p>
        </div>
      </div>
    </footer>

    <style>
      /* Port of mockups/civic-index-redesign/shared-v5.css
         (.skip-link / .masthead*) onto the canonical --ipc-* tokens. */
      .skip-link {
        background: var(--ipc-color-ink);
        color: var(--ipc-color-paper);
        font-size: var(--ipc-type-small);
        font-weight: 700;
        left: 0.5rem;
        padding: 0.5rem 0.9rem;
        position: absolute;
        text-decoration: none;
        top: 0.5rem;
        transform: translateY(-150%);
        transition: transform 0.15s ease;
        z-index: 100;
      }

      .skip-link:focus {
        outline: 2px solid var(--ipc-color-teal-ink);
        outline-offset: 2px;
        transform: translateY(0);
      }

      .masthead {
        border-bottom: 1px solid var(--ipc-color-rule);
        padding-block: 0.85rem;
      }

      .masthead .container {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.25rem;
        justify-content: space-between;
        max-width: 76rem;
      }

      .masthead-mark {
        color: var(--ipc-color-ink);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.01em;
        text-decoration: none;
      }

      .masthead-mark span {
        color: var(--ipc-color-teal-ink);
      }

      .masthead-mark:focus-visible {
        outline: 2px solid var(--ipc-color-teal-ink);
        outline-offset: 2px;
      }

      .masthead-nav {
        align-items: center;
        display: flex;
        gap: 0.6rem;
        font-size: var(--ipc-type-small);
        font-weight: 600;
      }

      /* Quiet nav links: News / About / Donate. De-emphasized alongside the
         primary "Share an experience" and ghost "Volunteer" actions. */
      .masthead-nav-link {
        color: var(--ipc-color-ink-soft);
        text-decoration: none;
      }

      .masthead-nav-link:hover {
        color: var(--ipc-color-ink);
      }

      .masthead-nav-link:focus-visible {
        outline: 2px solid var(--ipc-color-teal-ink);
        outline-offset: 2px;
      }

      .nav-action {
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        font-weight: 700;
        padding: 0.45rem 0.9rem;
        text-decoration: none;
      }

      .nav-action:focus-visible {
        outline: 2px solid var(--ipc-color-teal-ink);
        outline-offset: 2px;
      }

      .nav-action-share {
        background: var(--ipc-color-deep-red);
        border-color: var(--ipc-color-deep-red);
        color: var(--ipc-color-paper) !important;
      }

      .nav-action-share:hover {
        background: var(--ipc-color-ink);
        border-color: var(--ipc-color-ink);
      }

      /* Volunteer: a quiet ghost action — lifted above plain text, below the
         red primary, so a core civic loop is not the least-visible thing in
         the bar. */
      .nav-action-volunteer {
        border-color: var(--ipc-color-ink-faint);
        color: var(--ipc-color-teal-ink) !important;
      }

      .nav-action-volunteer:hover {
        background: var(--ipc-color-teal-wash);
        border-color: var(--ipc-color-teal-ink);
      }

      @media (max-width: 767.98px) {
        .masthead .container {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.6rem;
        }

        .masthead-nav {
          flex-wrap: wrap;
          gap: 0.6rem 0.9rem;
        }
      }
    </style>

    <script>
      import "#src/lib/client/site.js";
    </script>
    <script is:inline define:vars={{ issueMessage }}>
      (function () {
        const openFeedback = function (message) {
          const feedback = window.__IPC_SENTRY_FEEDBACK__;
          if (!feedback || typeof feedback.open !== "function") {
            return false;
          }
          void feedback.open({ message });
          return true;
        };

        document.addEventListener("click", function (event) {
          const target = event.target instanceof Element ? event.target : null;
          const trigger = target?.closest("[data-issue-message]");

          if (!(trigger instanceof HTMLAnchorElement)) {
            return;
          }

          const message =
            trigger.getAttribute("data-issue-message") || issueMessage;

          if (!openFeedback(message)) {
            return;
          }

          event.preventDefault();
        });
      })();
    </script>
  </body>
</html>
