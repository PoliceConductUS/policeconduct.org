---
import MetricCardButton from "#src/components/MetricCardButton.astro";
import MetricCardLink from "#src/components/MetricCardLink.astro";
import type { MetricCardItem } from "#src/components/metric-card-types.js";

const { metric } = Astro.props as {
  metric: MetricCardItem;
};
const action = metric.action;
---

<article
  class:list={[
    "entity-metric-card",
    action?.kind === "button" && "entity-metric-card-with-primary-action",
  ]}
>
  <svg
    aria-hidden="true"
    class={`entity-metric-icon entity-metric-${metric.accent || "blue"}`}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <use href={`/icons.svg#metric-${metric.icon || "building"}`}></use>
  </svg>
  <div class="entity-metric-body">
    <p>{metric.label}</p>
    <strong>{metric.value}</strong>
    {metric.detail ? <span>{metric.detail}</span> : null}
  </div>
  {
    action ? (
      <div class="entity-metric-action">
        {action.kind === "link" ? (
          <MetricCardLink href={action.href}>{action.label}</MetricCardLink>
        ) : (
          <MetricCardButton href={action.href}>{action.label}</MetricCardButton>
        )}
      </div>
    ) : null
  }
</article>

<style>
  .entity-metric-card {
    background: #fbfcff;
    border: 1px solid #d5deeb;
    border-radius: 0.45rem;
    box-shadow: 0 1px 2px rgba(7, 24, 66, 0.04);
    display: grid;
    gap: 0.8rem;
    grid-template-columns: 2.8rem minmax(0, 1fr);
    grid-template-rows: auto auto;
    min-height: 8rem;
    padding: 1rem;
  }

  .entity-metric-card-with-primary-action {
    background: #f4f7fb;
  }

  .entity-metric-icon {
    grid-column: 1;
    grid-row: 1;
    height: 2.7rem;
    margin-top: 0.2rem;
    width: 2.7rem;
  }

  .entity-metric-blue {
    color: #174bff;
  }

  .entity-metric-green {
    color: #087f3b;
  }

  .entity-metric-purple {
    color: #5b2df5;
  }

  .entity-metric-red {
    color: #b42318;
  }

  .entity-metric-body {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .entity-metric-action {
    align-items: center;
    display: flex;
    grid-column: 1 / -1;
    grid-row: 2;
    justify-content: center;
    min-width: 0;
    text-align: center;
  }

  .entity-metric-card p {
    color: #071842;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .entity-metric-card strong {
    color: #071842;
    display: block;
    font-size: 1.5rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.12;
    margin: 0.25rem 0 0.3rem;
  }

  .entity-metric-card span {
    color: #33456f;
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.45;
  }
</style>
