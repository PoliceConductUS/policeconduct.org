---
import type { ReportDetailFacts } from "#src/lib/report-detail.js";
type Props = { description: string; facts: ReportDetailFacts };
const { description, facts } = Astro.props;
// Intake may already include these answers in the authored HTML. Compare
// visible text but keep the original description and answers untouched.
const visibleText = (value: string) =>
  value
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;|&#160;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/\s+/g, " ")
    .trim();
const existingText = visibleText(description);
const sections = [
  { label: "What happened", text: facts.whatHappened },
  { label: "How it felt", text: facts.feelings },
  { label: "Requested outcome", text: facts.desiredOutcome },
  { label: "More from this account", text: facts.whatElse },
  { label: "Why this account was shared", text: facts.purpose },
].filter(
  ({ label, text }) =>
    text && (label !== "What happened" || existingText !== visibleText(text)),
);
---

<h2>What happened</h2>
<div set:html={description} />
{
  sections.map(({ label, text }) => (
    <section>
      {label !== "What happened" ? <h2>{label}</h2> : null}
      {label === "How it felt" ? (
        <p>This is the person’s account of how the experience felt.</p>
      ) : null}
      <p class="authored-answer">{text}</p>
    </section>
  ))
}
