---
// Horizontal-scroll wrapper for wide `record-table` (and similar) tables,
// so a table with more columns than a narrow viewport scrolls inside its
// own box instead of breaking the page's mobile layout. Port of
// mockups/civic-index-redesign/shared-v5.css (.table-scroll).
//
// Purely structural: no props. Wrap the <table> itself, not surrounding
// prose (`<TableScroll><table class="record-table">...</table></TableScroll>`).
---

<div class="table-scroll">
  <slot />
</div>

<style>
  /* Scroll cue: an edge shadow shows on whichever side still has columns
     out of view. The two page-surface-colored layers travel with the table
     (`local`) and cover the shadow once that edge is reached; the two
     shadow layers stay fixed to the box (`scroll`). */
  .table-scroll {
    --table-scroll-cue: color-mix(
      in oklch,
      var(--ipc-color-ink) 24%,
      transparent
    );

    background:
      linear-gradient(to right, var(--ipc-color-paper-raised) 40%, transparent)
        left center / 2.5rem 100% no-repeat local,
      linear-gradient(to left, var(--ipc-color-paper-raised) 40%, transparent)
        right center / 2.5rem 100% no-repeat local,
      linear-gradient(to right, var(--table-scroll-cue), transparent) left
        center / 0.75rem 100% no-repeat scroll,
      linear-gradient(to left, var(--table-scroll-cue), transparent) right
        center / 0.75rem 100% no-repeat scroll;
    overflow-x: auto;
  }
</style>
