---
import { PERSONNEL_UGC_SUSPENDED_NOTICE } from "#src/lib/ugc-policy.js";
---

<section class="py-vh-2">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8">
        <div class="border p-4 bg-white shadow-sm">
          <h2 class="ipc-section-title">This form is paused</h2>
          <p class="text-muted mb-3">{PERSONNEL_UGC_SUSPENDED_NOTICE}</p>
          <p class="text-muted mb-3">
            We will turn submissions back on once every submission has a named
            reviewer and a stated turnaround.
          </p>
          <ul class="mb-0">
            <li>
              To fix or remove information about yourself, use the <a
                href="/legal-notice/data-subject-access-request/"
                >correction and removal request form</a
              >.
            </li>
            <li>
              To suggest a change to an agency record, use the <a
                href="/agency/suggest-edit/">agency edit form</a
              >.
            </li>
            <li>
              For anything else, <a href="/about/contact/">contact us</a>.
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
