---
import Breadcrumbs from "#src/components/Breadcrumbs.astro";
import "#src/styles/civic-ledger.css";
import SiteLayout from "#src/layouts/SiteLayout.astro";
import type { CivicIndexModel } from "#src/lib/data/civic-index.js";
import { buildWebPage, getSiteUrl } from "#src/lib/structured-data.js";

const { model, site } = Astro.props as {
  model: CivicIndexModel;
  site: URL | undefined;
};

const siteUrl = getSiteUrl(site);
const pageUrl = new URL(model.pagePath, siteUrl).toString();
const structuredData = buildWebPage({
  siteUrl,
  pageUrl,
  name: model.title,
  description: model.description,
  type: "CollectionPage",
});

const heading =
  model.breadcrumbs[model.breadcrumbs.length - 1]?.label ||
  model.jurisdictionLabel;

const assertString = (value: unknown, field: string, reportId: string) => {
  if (typeof value !== "string" || !value.trim()) {
    throw new Error(`Location report ${reportId} has invalid ${field}.`);
  }
  return value;
};

const assertSourceUrl = (value: string, sourceId: string, reportId: string) => {
  let parsed: URL;
  try {
    parsed = new URL(value);
  } catch {
    throw new Error(
      `Location report ${reportId} source ${sourceId} has invalid url.`,
    );
  }
  if (!["http:", "https:"].includes(parsed.protocol)) {
    throw new Error(
      `Location report ${reportId} source ${sourceId} url must be http or https.`,
    );
  }
};

type LocationReport = CivicIndexModel["locationReports"][number];

const assertReportSources = (report: LocationReport) => {
  if (!report.sources.length) {
    throw new Error(`Location report ${report.id} must include sources.`);
  }
  for (const source of report.sources) {
    assertString(source.id, "source.id", report.id);
    assertString(source.sourceKey, `source ${source.id} sourceKey`, report.id);
    assertString(source.label, `source ${source.id} label`, report.id);
    assertString(source.url, `source ${source.id} url`, report.id);
    assertSourceUrl(source.url, source.id, report.id);
    if (!["law", "methodology", "pdf", "web"].includes(source.sourceType)) {
      throw new Error(
        `Location report ${report.id} source ${source.id} has invalid sourceType ${source.sourceType}.`,
      );
    }
  }
  return new Set(report.sources.map((source) => source.sourceKey));
};

type DecertificationColumn = {
  key: string;
  label: string;
  sourceKeys?: string[];
  status: "missing" | "present" | "unknown";
};

type DecertificationPayload = {
  columns: DecertificationColumn[];
  methodology?: string;
  note?: string;
  tier?: string;
};

const assertDecertificationPayload = (
  report: LocationReport,
): DecertificationPayload => {
  if (report.reportType !== "decertification_report_card") {
    throw new Error(`Unsupported location report type: ${report.reportType}`);
  }
  const sourceKeys = assertReportSources(report);

  const payload = report.payload as Record<string, unknown>;
  const methodology = assertString(
    payload.methodology,
    "methodology",
    report.id,
  );
  const tier = assertString(payload.tier, "tier", report.id);
  const note = assertString(payload.note, "note", report.id);
  const columns = payload.columns;
  if (!Array.isArray(columns) || !columns.length) {
    throw new Error(`Location report ${report.id} is missing columns.`);
  }

  const validatedColumns = columns.map((rawColumn, index) => {
    if (!rawColumn || typeof rawColumn !== "object") {
      throw new Error(
        `Location report ${report.id} column ${index + 1} must be an object.`,
      );
    }
    const column = rawColumn as Record<string, unknown>;
    const key = assertString(column.key, `columns[${index}].key`, report.id);
    const label = assertString(
      column.label,
      `columns[${index}].label`,
      report.id,
    );
    const status = assertString(
      column.status,
      `columns[${index}].status`,
      report.id,
    );
    if (!["present", "missing", "unknown"].includes(status)) {
      throw new Error(
        `Location report ${report.id} column ${key} has invalid status ${status}.`,
      );
    }
    if (!Array.isArray(column.sourceKeys) || !column.sourceKeys.length) {
      throw new Error(
        `Location report ${report.id} column ${key} must include sourceKeys.`,
      );
    }
    const columnSourceKeys = column.sourceKeys.map((sourceKey, sourceIndex) =>
      assertString(
        sourceKey,
        `columns[${index}].sourceKeys[${sourceIndex}]`,
        report.id,
      ),
    );
    for (const sourceKey of columnSourceKeys) {
      if (!sourceKeys.has(sourceKey)) {
        throw new Error(
          `Location report ${report.id} column ${key} references missing source ${sourceKey}.`,
        );
      }
    }
    return {
      key,
      label,
      sourceKeys: columnSourceKeys,
      status: status as DecertificationColumn["status"],
    };
  });

  return {
    columns: validatedColumns.filter(
      (column) => !["state", "name", "jurisdiction"].includes(column.key),
    ),
    methodology,
    note,
    tier,
  };
};

const statusLabel = (status: DecertificationColumn["status"]) =>
  status === "present"
    ? "Present"
    : status === "missing"
      ? "Missing"
      : "Unknown";

type LicensingPayload = {
  facts: { key: string; label: string; value: string }[];
  note: string | null;
  organization: { abbreviation: string; name: string; url: string };
};

const assertLicensingPayload = (report: LocationReport): LicensingPayload => {
  if (report.reportType !== "licensing_summary") {
    throw new Error(`Unsupported location report type: ${report.reportType}`);
  }
  const sourceKeys = assertReportSources(report);

  const payload = report.payload as Record<string, unknown>;
  const organization = payload.organization as Record<string, unknown> | null;
  if (!organization || typeof organization !== "object") {
    throw new Error(`Location report ${report.id} is missing organization.`);
  }
  const organizationName = assertString(
    organization.name,
    "organization.name",
    report.id,
  );
  const organizationAbbreviation = assertString(
    organization.abbreviation,
    "organization.abbreviation",
    report.id,
  );
  const organizationUrl = assertString(
    organization.url,
    "organization.url",
    report.id,
  );
  assertSourceUrl(organizationUrl, "organization", report.id);

  const facts = payload.facts;
  if (!Array.isArray(facts) || !facts.length) {
    throw new Error(`Location report ${report.id} is missing facts.`);
  }
  const validatedFacts = facts.map((rawFact, index) => {
    if (!rawFact || typeof rawFact !== "object") {
      throw new Error(
        `Location report ${report.id} fact ${index + 1} must be an object.`,
      );
    }
    const fact = rawFact as Record<string, unknown>;
    const key = assertString(fact.key, `facts[${index}].key`, report.id);
    const label = assertString(fact.label, `facts[${index}].label`, report.id);
    const value = assertString(fact.value, `facts[${index}].value`, report.id);
    if (Array.isArray(fact.sourceKeys)) {
      for (const sourceKey of fact.sourceKeys) {
        if (typeof sourceKey !== "string" || !sourceKeys.has(sourceKey)) {
          throw new Error(
            `Location report ${report.id} fact ${key} references missing source ${String(sourceKey)}.`,
          );
        }
      }
    }
    return { key, label, value };
  });

  return {
    facts: validatedFacts,
    note: typeof payload.note === "string" ? payload.note : null,
    organization: {
      abbreviation: organizationAbbreviation,
      name: organizationName,
      url: organizationUrl,
    },
  };
};

const decertificationReport = model.locationReports.find(
  (report) => report.reportType === "decertification_report_card",
);
const decertificationPayload = decertificationReport
  ? assertDecertificationPayload(decertificationReport)
  : null;
const decertificationPresentCount =
  decertificationPayload?.columns.filter(
    (column) => column.status === "present",
  ).length ?? 0;
const decertificationMissingCount =
  decertificationPayload?.columns.filter(
    (column) => column.status === "missing",
  ).length ?? 0;
const decertificationUnknownCount =
  decertificationPayload?.columns.filter(
    (column) => column.status === "unknown",
  ).length ?? 0;
const decertificationTotal = decertificationPayload?.columns.length ?? 0;
const decertificationSource = decertificationReport?.sources.find(
  (source) => source.sourceType === "methodology",
);

const licensingReport = model.locationReports.find(
  (report) => report.reportType === "licensing_summary",
);
const licensingPayload = licensingReport
  ? assertLicensingPayload(licensingReport)
  : null;

const statColumns = model.statCells.length + 1;
---

<SiteLayout
  title={model.title}
  description={model.description}
  pagePath={model.pagePath}
  structuredData={structuredData}
>
  <main id="main" class="civic-index-page">
    <section class="civic-index-page-main">
      <div class="container">
        <Breadcrumbs items={model.breadcrumbs} className="mb-2" />

        <section class="civic-lede">
          <p class="civic-kicker">{model.jurisdictionLabel}</p>
          <h1>{heading}</h1>
          <p class="civic-lede-sub">{model.description}</p>
        </section>

        <section
          class:list={[
            "stat-strip",
            { "stat-strip--three": statColumns === 4 },
          ]}
          aria-label={`${heading} coverage totals`}
        >
          {
            model.statCells.map((cell) =>
              cell.href ? (
                <a
                  class="stat-cell stat-cell--link"
                  data-role={cell.role}
                  href={cell.href}
                >
                  <strong class="ledger-value">{cell.value}</strong>
                  <span class="ledger-label">{cell.label}</span>
                  {cell.meta ? (
                    <span class="ledger-meta">{cell.meta}</span>
                  ) : null}
                  {cell.actionLabel ? (
                    <span class="stat-action">{cell.actionLabel}</span>
                  ) : null}
                </a>
              ) : (
                <div
                  class:list={["stat-cell", { "is-pending": !cell.value }]}
                  data-role={cell.role}
                >
                  <strong class="ledger-value">{cell.value ?? "--"}</strong>
                  <span class="ledger-label">{cell.label}</span>
                  {cell.meta ? (
                    <span class="ledger-meta">{cell.meta}</span>
                  ) : null}
                  {cell.pendingHelp ? (
                    <span class="stat-action">
                      <a href={cell.pendingHelp.href}>
                        {cell.pendingHelp.label}
                      </a>
                    </span>
                  ) : null}
                </div>
              ),
            )
          }
          <div class="stat-cell jump-cell">
            <strong class="ledger-value">{model.jumpCell.count}</strong>
            <span class="ledger-label">{model.jumpCell.label}</span>
            <form class="jump-form" data-jump-form>
              <label for="civic-jump" class="visually-hidden">
                {model.jumpCell.selectLabel}
              </label>
              <select id="civic-jump" class="jump-select" data-jump-select>
                <option value="" selected disabled>
                  {model.jumpCell.placeholder}
                </option>
                {
                  model.jumpCell.options.map((option) => (
                    <option value={option.href}>{option.label}</option>
                  ))
                }
              </select>
              <button class="jump-go" type="submit">Go →</button>
            </form>
            <p class="jump-status" data-jump-status aria-live="polite"></p>
            <p class="jump-browse">
              <a href={model.jumpCell.browse.href}>
                {model.jumpCell.browse.label}
              </a>
            </p>
          </div>
        </section>

        <section class="civic-section">
          <div class="civic-section-head">
            <div>
              <h2>Not yet collected</h2>
              <p>
                These record types are not on this site yet. You can help
                request and review the source records.
              </p>
            </div>
          </div>
          <ul class="topic-row">
            {
              model.pendingTopics.map((topic) => (
                <li class="topic-cell is-pending" data-role={topic.role}>
                  <span class="ledger-label">{topic.label}</span>
                  <span class="topic-value">Not yet available</span>
                  <span class="topic-foot">
                    <a href={topic.help.href}>{topic.help.label}</a>
                  </span>
                </li>
              ))
            }
          </ul>
        </section>

        {
          licensingReport && licensingPayload ? (
            <section class="civic-section">
              <div class="civic-section-head">
                <div>
                  <h2>{licensingReport.title}</h2>
                  <p>{licensingReport.summary}</p>
                </div>
                <p class="civic-section-link">
                  <a href={licensingPayload.organization.url} rel="noopener">
                    {licensingPayload.organization.name} →
                  </a>
                </p>
              </div>
              <p class="civic-context-copy">
                The license is what stands between a fired officer and a new
                badge: researchers call officers who are fired by one department
                and hired by another{" "}
                <a
                  href="https://www.yalelawjournal.org/article/the-wandering-officer"
                  rel="noopener"
                >
                  "wandering officers,"
                </a>{" "}
                and one study found about 3 in 100 working Florida officers had
                been fired from an earlier policing job. An officer who loses
                their license cannot wander.
              </p>
              <dl class="fact-list">
                {licensingPayload.facts.map((fact) => (
                  <div>
                    <dt>{fact.label}</dt>
                    <dd>{fact.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ) : null
        }

        {
          decertificationReport && decertificationPayload ? (
            <section class="civic-section civic-section--last">
              <div class="civic-section-head">
                <div>
                  <h2>{decertificationReport.title}</h2>
                  <p>{decertificationReport.summary}</p>
                </div>
                {decertificationSource ? (
                  <p class="civic-section-link">
                    <span>
                      {decertificationMissingCount} missing
                      {decertificationUnknownCount > 0
                        ? ` · ${decertificationUnknownCount} unknown`
                        : ""}
                      {" · "}
                    </span>
                    <a href={decertificationSource.url} rel="noopener">
                      Report source
                    </a>
                  </p>
                ) : null}
              </div>
              <div
                class="status-ledger"
                aria-label={`${heading} decertification report card statuses`}
              >
                <div class="status-cell status-summary">
                  <h3 class="status-heading">Present</h3>
                  <strong class="status-summary-value">
                    {decertificationPresentCount} of {decertificationTotal}
                  </strong>
                </div>
                {decertificationPayload.columns.map((column) => (
                  <div class="status-cell">
                    <h3 class="status-heading">{column.label}</h3>
                    <span class:list={["status-mark", column.status]}>
                      {statusLabel(column.status)}
                    </span>
                  </div>
                ))}
              </div>
              <p class="civic-limit-note">{decertificationPayload.note}</p>
            </section>
          ) : null
        }
      </div>
    </section>
  </main>
</SiteLayout>
