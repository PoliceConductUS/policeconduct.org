---
import Breadcrumb from "#src/components/Breadcrumb.astro";
import StatCell from "#src/components/StatCell.astro";
import SiteLayout from "#src/layouts/SiteLayout.astro";
import {
  buildHelpCollectHref,
  type CivicIndexModel,
} from "#src/lib/data/civic-index.js";
import type {
  CivicTopicKind,
  CivicTopicRecords,
} from "#src/lib/data/civic-topic-records.js";
import { metricLabels } from "#src/lib/metric-vocabulary.js";
import "#src/styles/civic-ledger.css";

const { model, kind, records } = Astro.props as {
  model: CivicIndexModel;
  kind: CivicTopicKind;
  records?: CivicTopicRecords;
};

const coverageValue = (key: CivicIndexModel["coverage"][number]["key"]) =>
  model.coverage.find((metric) => metric.key === key)?.value ?? 0;

const pageConfig = {
  personnel: {
    title: metricLabels.personnel,
    description: `Personnel records connected to this geography.`,
    role: null,
    gloss: undefined,
  },
  budget: {
    title: metricLabels.budget,
    description: "Budget, revenue, spending, forfeiture, and overtime records.",
    role: "budget" as const,
    gloss: "Yearly department spending",
  },
  "civil-cases": {
    title: metricLabels.civilCases,
    description: "Civil cases connected to this geography, from court records.",
    role: "civil" as const,
    gloss: undefined,
  },
  "fatal-force-incidents": {
    title: metricLabels.fatalForceIncidents,
    description:
      "Deaths involving police contact, including custody and pursuit deaths.",
    role: "neutral" as const,
    gloss: "Deaths involving police",
  },
  "liability-costs": {
    title: metricLabels.liabilityCosts,
    description:
      "Claims, settlements, judgments, defense costs, and related payments.",
    role: "liability" as const,
    gloss: "Payouts in police-conduct cases",
  },
  "outcomes-by-income": {
    title: metricLabels.outcomesByIncome,
    description: "Case outcomes grouped by income, where source data exists.",
    role: "neutral" as const,
    gloss: "Case results by neighborhood income",
  },
}[kind];

const heading =
  model.breadcrumbs[model.breadcrumbs.length - 1]?.label ||
  model.jurisdictionLabel;
const pagePath = `${model.pagePath}${kind}/`;
const pageTitle = `${heading} ${pageConfig.title}`;
const entitySlug = model.pagePath.split("/").filter(Boolean).pop() || "";
const volunteerHref = buildHelpCollectHref(pagePath, model.level, entitySlug);

const hasRows = records ? records.rows.length > 0 : false;
const personnelCount = coverageValue("personnel");
---

<SiteLayout
  title={`${pageTitle} | PoliceConduct.org`}
  description={pageConfig.description}
  pagePath={pagePath}
>
  <main id="main" class="civic-index-page">
    <section class="civic-index-page-main">
      <div class="container">
        <Breadcrumb
          items={[
            ...model.breadcrumbs.map((item) => ({ ...item, current: false })),
            { label: pageConfig.title, href: pagePath },
          ]}
        />

        <section class="civic-lede">
          <p class="civic-kicker">{heading}</p>
          <h1>{pageConfig.title}</h1>
          <p class="civic-lede-sub">{pageConfig.description}</p>
        </section>

        {
          kind === "personnel" ? (
            <section class="civic-section civic-section--last">
              <dl class="fact-list">
                <div>
                  <dt>Personnel records</dt>
                  <dd>{personnelCount.toLocaleString("en-US")}</dd>
                </div>
                <div>
                  <dt>Rosters</dt>
                  <dd>Browsable on each agency page</dd>
                </div>
              </dl>
              <p class="civic-limit-note">
                Personnel records come from state licensing data and are listed
                on each agency's page.
                <a href="/find-records/">Find an agency →</a>
              </p>
            </section>
          ) : hasRows ? (
            <section class="civic-section civic-section--last">
              <slot />
              <p class="civic-limit-note">
                Case records come from court dockets. A pending case is an
                allegation, not a finding. A dismissal is a court outcome, not a
                statement that no misconduct occurred.
              </p>
            </section>
          ) : (
            <section class="civic-section civic-section--last">
              <ul class="topic-row">
                <StatCell
                  variant="topic"
                  label={pageConfig.title}
                  gloss={pageConfig.gloss}
                  role={pageConfig.role ?? undefined}
                  empty
                  helpCollectHref={volunteerHref}
                />
              </ul>
            </section>
          )
        }
      </div>
    </section>
  </main>
</SiteLayout>
