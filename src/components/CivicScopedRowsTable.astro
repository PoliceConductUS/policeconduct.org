---
import CivilCaseScopeNote from "#src/components/CivilCaseScopeNote.astro";
import type {
  CivicCivilCaseRecord,
  CivicTopicRecords,
} from "#src/lib/data/civic-topic-records.js";

const { records } = Astro.props as {
  records: CivicTopicRecords;
};

const civilCaseRows: CivicCivilCaseRecord[] =
  records.kind === "civil-cases" ? records.rows.slice(0, 50) : [];
const renderTable = records.kind === "civil-cases";
const empty = records.rows.length === 0;

const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(new Date(value));
---

{
  renderTable && !empty ? (
    <div>
      <div class="list-tools">
        <span class="list-count">
          {records.totalCount.toLocaleString("en-US")} cases
          {records.totalCount > civilCaseRows.length
            ? ` · showing the ${civilCaseRows.length} most recent`
            : ""}
        </span>
      </div>
      <table class="record-table">
        <thead>
          <tr>
            <th scope="col">Case</th>
            <th scope="col">Court</th>
            <th scope="col">Filed</th>
            <th scope="col">Connection</th>
            <th scope="col">Agencies</th>
          </tr>
        </thead>
        <tbody>
          {civilCaseRows.map((row) => (
            <tr>
              <td>
                <a class="row-link" href={row.href}>
                  {row.title}
                </a>
              </td>
              <td>{row.court || ""}</td>
              <td>{formatDate(row.filedDate)}</td>
              <td>{row.connectionType}</td>
              <td>
                {row.agencies.map((agency, index) => (
                  <>
                    {index > 0 ? ", " : ""}
                    <a class="row-link" href={agency.href}>
                      {agency.name}
                    </a>
                  </>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="list-foot">
        <span>Sorted by filing date, newest first</span>
        <CivilCaseScopeNote />
      </div>
    </div>
  ) : null
}
