---
import type { ArrestProfileRecord } from "#src/lib/data/arrest-profiles.js";
import { formatShortDate } from "#src/lib/format.js";
interface Props {
  profiles: ArrestProfileRecord[];
}
const { profiles } = Astro.props;
const dimensions = [
  ["by_year", "Year"],
  ["by_month", "Month"],
  ["by_iso_week", "Week (ISO calendar)"],
  ["by_day_of_week", "Day of week"],
  ["by_hour", "Hour as recorded"],
  ["arrests_by_offense", "Arrests by offense as recorded"],
  ["arrests_by_level", "Arrests by charge level source codes"],
  ["charge_rows_by_offense", "Charge rows by offense as recorded"],
  ["charge_rows_by_level", "Charge rows by level source codes"],
  [
    "distinct_charge_records_by_offense",
    "Distinct reported charge records by offense",
  ],
  [
    "distinct_charge_records_by_level",
    "Distinct reported charge records by level",
  ],
  ["by_source_district", "District source codes"],
  ["by_arrest_beat", "Arrest-location beat codes"],
  ["by_beat_status", "Arrest-location matching results"],
  ["by_residential_tract", "Residential census tract codes"],
  ["by_income_status", "Residential income matching results"],
] as const;
const collator = new Intl.Collator("en", { numeric: true });
const days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const rowsFor = (
  profile: ArrestProfileRecord,
  key: keyof ArrestProfileRecord["breakdowns"],
) =>
  Object.entries(profile.breakdowns[key] as Record<string, number>).sort(
    ([left], [right]) => {
      if (key === "by_day_of_week") {
        const a = days.indexOf(left),
          b = days.indexOf(right);
        if (a !== -1 || b !== -1)
          return (a === -1 ? 7 : a) - (b === -1 ? 7 : b);
      }
      return collator.compare(left, right);
    },
  );
---

{
  profiles.length > 0 && (
    <section id="arrest-records" class="arrest-records">
      <div class="arrest-records-heading">
        <h2>Arrest records</h2>
        <slot name="introduction">
          <p>
            These are recorded arrests linked to this agency assignment. They do
            not measure safety or misconduct.
          </p>
        </slot>
      </div>
      {profiles.map((profile) => (
        <article data-arrest-profile-id={profile.id}>
          <h3>
            <a href={profile.agency.href}>{profile.agency.name}</a>
          </h3>
          <p>
            <strong>
              {profile.coverage.totalArrests.toLocaleString("en-US")} recorded
              arrests
            </strong>{" "}
            · Recorded months: {profile.coverage.firstMonth} to{" "}
            {profile.coverage.lastMonth}
          </p>
          <p>
            Source: {profile.coverage.source} · Updated{" "}
            {formatShortDate(profile.updatedAt)}
          </p>
          <p>
            {profile.coverage.chargeRows.toLocaleString("en-US")} charge rows ·{" "}
            {profile.coverage.distinctChargeRecords.toLocaleString("en-US")}{" "}
            distinct reported charge records
          </p>
          <p>
            Each arrest is one distinct booking. An arrest can appear in more
            than one offense or charge-level group. Charge rows include repeated
            source rows. Distinct reported charge records are distinct complete
            charge entries within a booking, not a verified count of separate
            legal charges.
          </p>
          <p>
            Source wording and unknown groups are kept as recorded. District
            codes are source codes. Arrest-location beats use supplied polygons
            without historical boundary dates. Residential tracts describe home
            neighborhoods, not arrest locations or personal income.
          </p>
          {dimensions
            .filter(
              ([key]) =>
                key === "by_year" ||
                key === "by_month" ||
                key === "by_iso_week" ||
                key === "by_day_of_week" ||
                Object.hasOwn(profile.breakdowns, key),
            )
            .map(([key, label]) => (
              <details open={key === "by_year" || key === "by_day_of_week"}>
                <summary>
                  {label} (
                  {rowsFor(profile, key).length.toLocaleString("en-US")} groups)
                </summary>
                <div class="table-responsive">
                  <table class="table" data-breakdown={key}>
                    <caption>{label}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{label}</th>
                        <th scope="col">
                          {key.startsWith("charge_rows_")
                            ? "Charge rows"
                            : key.startsWith("distinct_charge_records_")
                              ? "Distinct reported charge records"
                              : "Recorded arrests"}
                        </th>
                        <th scope="col">
                          {key.startsWith("charge_rows_")
                            ? "Share of charge rows"
                            : key.startsWith("distinct_charge_records_")
                              ? "Share of distinct reported charge records"
                              : "Share of arrests"}
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      {rowsFor(profile, key).map(([label, count]) => (
                        <tr>
                          <th scope="row">{label}</th>
                          <td>{count.toLocaleString("en-US")}</td>
                          <td>
                            {(key.startsWith("charge_rows_")
                              ? profile.coverage.chargeRows
                              : key.startsWith("distinct_charge_records_")
                                ? profile.coverage.distinctChargeRecords
                                : profile.coverage.totalArrests) === 0
                              ? "0.0"
                              : (
                                  (count /
                                    (key.startsWith("charge_rows_")
                                      ? profile.coverage.chargeRows
                                      : key.startsWith(
                                            "distinct_charge_records_",
                                          )
                                        ? profile.coverage.distinctChargeRecords
                                        : profile.coverage.totalArrests)) *
                                  100
                                ).toFixed(1)}
                            %
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            ))}
        </article>
      ))}
    </section>
  )
}

<style>
  .arrest-records {
    grid-column: 1 / -1;
    background: var(--ipc-color-paper);
    border: 1px solid var(--ipc-color-rule);
    border-radius: 0.45rem;
    padding: 1rem 1.1rem;
  }
  .arrest-records-heading {
    margin-bottom: 0.85rem;
  }
  .arrest-records h2 {
    margin: 0 0 0.25rem;
  }
  .arrest-records p {
    color: var(--ipc-color-ink);
  }
  .arrest-records a {
    color: var(--ipc-color-teal);
  }
  .arrest-records details {
    margin-bottom: 0.75rem;
  }
  .arrest-records summary {
    cursor: pointer;
    font-weight: var(--ipc-weight-label);
  }
  .arrest-records table {
    min-width: 32rem;
  }
  @media (max-width: 575.98px) {
    .arrest-records table {
      min-width: 0;
      width: 100%;
      table-layout: fixed;
    }
    .arrest-records th,
    .arrest-records td {
      overflow-wrap: anywhere;
    }
  }
</style>
