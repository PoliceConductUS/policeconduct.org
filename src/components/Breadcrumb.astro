---
import { getSiteUrl } from "#src/lib/structured-data.js";

// Shared civic-index-redesign breadcrumb trail. Renders exactly the items
// given — no automatic "Home" injection — the last item is always treated as
// the current page (aria-current="page", no link), matching
// mockups/civic-index-redesign/shared-v5.css (.crumbs) and every
// texas-v9.html / agency-entity-v8.html breadcrumb instance.
//
// This is intentionally a separate, leaner component from the existing
// src/components/Breadcrumbs.astro (plural), which auto-injects "Home".
// Like the plural component, it emits BreadcrumbList JSON-LD so the deep
// entity/geographic pages that use this trail expose their hierarchy to
// search and AI answer engines.
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const lastIndex = items.length - 1;

// Emit BreadcrumbList JSON-LD only for a well-formed trail: at least two
// items, and every item except the current (last) one has an href. The
// current item resolves to this page's own URL.
const siteUrl = getSiteUrl(Astro.site);
const currentPath = Astro.url?.pathname || "/";
const hasValidTrail =
  items.length >= 2 &&
  items.every((item, index) => index === lastIndex || Boolean(item.href));
const breadcrumbData = hasValidTrail
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: items.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.label,
        // hasValidTrail guarantees every non-current item has an href; the
        // current (last) item falls back to this page's own path.
        item: new URL(item.href || currentPath, siteUrl).toString(),
      })),
    }
  : null;
const serializedBreadcrumbData = breadcrumbData
  ? JSON.stringify(breadcrumbData).replace(/</g, "\\u003c")
  : "";
---

<nav aria-label="Breadcrumb" data-pagefind-ignore>
  <ol class="crumbs">
    {
      items.map((item, index) => {
        const isCurrent = index === lastIndex;
        return (
          <li aria-current={isCurrent ? "page" : undefined}>
            {!isCurrent && item.href ? (
              <a href={item.href}>{item.label}</a>
            ) : (
              item.label
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
{
  breadcrumbData ? (
    <script
      type="application/ld+json"
      set:html={serializedBreadcrumbData}
      is:inline
    />
  ) : null
}

<style>
  .crumbs {
    color: var(--ipc-color-ink-faint);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--ipc-type-caption);
    font-weight: 600;
    gap: 0.4rem;
    letter-spacing: 0.02em;
    list-style: none;
    margin: 1.35rem 0 0;
    padding: 0;
    text-transform: uppercase;
  }

  .crumbs li::after {
    color: var(--ipc-color-rule-strong);
    content: "/";
    margin-left: 0.4rem;
  }

  .crumbs li:last-child::after {
    content: "";
  }

  .crumbs a {
    color: var(--ipc-color-ink-muted);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ipc-color-ink);
  }

  .crumbs a:focus-visible {
    outline: 2px solid var(--ipc-color-teal-ink);
    outline-offset: 2px;
  }

  .crumbs [aria-current] {
    color: var(--ipc-color-ink);
  }
</style>
