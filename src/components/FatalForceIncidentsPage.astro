---
import Breadcrumb from "#src/components/Breadcrumb.astro";
import DataPanel from "#src/components/DataPanel.astro";
import PageHeader from "#src/components/PageHeader.astro";
import HelpCollectDataButton from "#src/components/HelpCollectDataButton.astro";
import MetricGrid from "#src/components/MetricGrid.astro";
import SampleMeasurementChart from "#src/components/SampleMeasurementChart.astro";
import SiteLayout from "#src/layouts/SiteLayout.astro";
import { metricVisuals } from "#src/lib/metric-vocabulary.js";
import type { MetricCardItem } from "#src/components/metric-card-types.js";
import { buildCollectionPage, getSiteUrl } from "#src/lib/structured-data.js";
import "#src/styles/civic-ledger.css";

const { breadcrumbs, description, pagePath, title } = Astro.props as {
  breadcrumbs: { current?: boolean; href: string; label: string }[];
  description: string;
  pagePath: string;
  title: string;
};

const breadcrumbItems = breadcrumbs.map(({ href, label }) => ({
  label,
  href,
}));

const siteUrl = getSiteUrl(Astro.site);
const structuredData = buildCollectionPage({
  siteUrl,
  pageUrl: new URL(pagePath, siteUrl).toString(),
  name: `${title} | PoliceConduct.org`,
  description,
});

const metricCards: MetricCardItem[] = [
  {
    ...metricVisuals.fatalForceIncidents,
    value: "0",
    detail: "Fatal force incidents from the past 5 years",
  },
  {
    ...metricVisuals.fatalForceIncidents,
    value: "--",
    detail: "People under 18",
  },
  {
    ...metricVisuals.fatalForceIncidents,
    value: "--",
    detail: "People 18 and older",
  },
  {
    ...metricVisuals.fatalForceIncidents,
    value: "--",
    detail: "Dogs",
  },
  {
    ...metricVisuals.fatalForceIncidents,
    value: "--",
    detail: "Other animals",
  },
];

const chartTitles = [
  "Fatal Force Incidents, 5 Years",
  "Fatal Force Incidents by Age",
  "Fatal Force Incidents Involving Animals",
];
const sampleRows = [
  { label: "Under 18", value: "--", width: 12 },
  { label: "18 and older", value: "--", width: 58 },
  { label: "Dogs", value: "--", width: 34 },
  { label: "Other animals", value: "--", width: 14 },
];
---

<SiteLayout
  title={`${title} | PoliceConduct.org`}
  description={description}
  pagePath={pagePath}
  canonicalUrl={pagePath}
  structuredData={structuredData}
>
  <main id="main" class="fatal-force-page">
    <section class="fatal-force-overview">
      <div class="container">
        <Breadcrumb items={breadcrumbItems} />
        <PageHeader title={title} description={description}>
          <Fragment slot="actions">
            <HelpCollectDataButton
              context={title}
              sourcePage={pagePath}
              topic="Fatal Force Incidents"
            />
            <button type="button" class="entity-action"> Share </button>
            <button type="button" class="entity-action">
              Download report
            </button>
          </Fragment>
        </PageHeader>

        <MetricGrid metrics={metricCards} columns="auto" />

        <div class="entity-chart-grid">
          {
            chartTitles.map((chartTitle) => (
              <DataPanel title={chartTitle}>
                <SampleMeasurementChart
                  ariaLabel={`Sample ${chartTitle} chart`}
                  rows={sampleRows}
                />
              </DataPanel>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .fatal-force-page {
    background: #fbfcff;
    color: #071842;
  }

  .fatal-force-overview {
    padding: 1.35rem 0 2rem;
  }

  .fatal-force-overview > .container {
    max-width: 1240px;
  }
</style>
