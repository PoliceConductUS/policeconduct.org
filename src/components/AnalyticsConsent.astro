---
---

<div class="analytics-privacy" data-pagefind-ignore>
  <dialog
    data-analytics-consent
    aria-labelledby="analytics-consent-title"
    aria-describedby="analytics-consent-description"
    hidden
  >
    <div class="analytics-consent-body">
      <p>
        <strong id="analytics-consent-title">Manage cookie settings</strong>
      </p>
      <p id="analytics-consent-description">
        We use Google Analytics to learn how this site is used. You can allow
        analytics cookies or decline them. If you decline, Google still receives
        limited measurements without analytics cookies. Choose separately
        whether to allow advertising cookies and data use. Change your choices
        here at any time.
      </p>
      <div class="analytics-categories">
        <label>
          <input type="checkbox" checked disabled /> Necessary settings — always
          on
        </label>
        <p>We remember the cookie choice you save in this browser.</p>
        <label>
          <input type="checkbox" data-analytics-enabled /> Analytics cookies
        </label>
        <p>Allow Google Analytics to use cookies to measure visits.</p>
        <label>
          <input type="checkbox" data-advertising-enabled /> Advertising
        </label>
        <p>
          Allow Google to use cookies and visit data for ad measurement and
          personalized ads.
        </p>
      </div>
    </div>
    <div class="analytics-consent-actions">
      <p data-consent-status role="status"></p>
      <div class="analytics-choices">
        <button type="button" data-analytics-choice="granted">
          Allow all
        </button>
        <button type="button" data-analytics-save>
          Save preferences
        </button>
        <button type="button" data-analytics-choice="denied">
          Decline all
        </button>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { initializeConsentControls } from "../lib/client/analytics-consent.js";
  initializeConsentControls();
</script>

<style>
  .analytics-privacy dialog {
    width: min(32rem, calc(100vw - 2rem));
    max-height: 80vh;
    margin: auto;
    padding: 0;
    color: var(--ipc-color-ink);
    background: var(--ipc-color-paper-raised);
    border: 1px solid var(--ipc-color-ink);
    font-size: 1rem;
    line-height: 1.5;
  }
  /* The text scrolls; the status line and the three choice buttons stay
     in view below it at every screen size. */
  .analytics-privacy dialog[open]:not([hidden]) {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .analytics-consent-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    /* Scrolling past the end of the text does not scroll the page behind. */
    overscroll-behavior: contain;
    padding: 1.5rem 1.5rem 0;
  }
  .analytics-privacy [data-consent-status]:empty {
    margin: 0;
  }
  /* On a short screen (a phone on its side, 400% zoom) the dialog uses
     nearly the full height and the button area tightens, so the stacked
     buttons still leave room to read the text. */
  @media (max-height: 30rem) {
    .analytics-privacy dialog {
      max-height: calc(100dvh - 1rem);
    }
    .analytics-consent-body {
      padding: 0.75rem 1rem 0;
    }
    .analytics-privacy .analytics-consent-actions {
      padding: 0.5rem 1rem;
    }
    .analytics-privacy .analytics-choices {
      gap: 0.5rem;
    }
  }
  /* Opening the dialog puts keyboard focus on the scrolling text, at its
     top, so the explanation is read first and arrow keys scroll it. */
  .analytics-consent-body:focus-visible {
    outline: 3px solid var(--ipc-color-ink);
    outline-offset: -3px;
  }
  .analytics-consent-actions {
    flex: none;
    border-top: 1px solid var(--ipc-color-ink);
    padding: 1rem 1.5rem 1.5rem;
  }
  .analytics-privacy dialog::backdrop {
    background: rgb(23 43 77 / 45%);
  }
  .analytics-categories label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
  }
  .analytics-categories input {
    width: 1.25rem;
    height: 1.25rem;
  }
  .analytics-categories p {
    margin-top: 0.25rem;
  }
  .analytics-privacy input:focus-visible {
    outline: 3px solid var(--ipc-color-ink);
    outline-offset: 3px;
  }
  .analytics-privacy p {
    margin: 0 0 1rem;
  }
  .analytics-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .analytics-privacy button {
    font: inherit;
    color: var(--ipc-color-ink);
    background: var(--ipc-color-paper-raised);
    border: 1px solid var(--ipc-color-ink);
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition:
      background-color 150ms ease-out,
      scale 150ms ease-out;
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) {
    .analytics-privacy button:hover {
      background: rgb(23 43 77 / 8%);
    }
  }
  /* A pressed button darkens; where motion is allowed it also shrinks a
     little. */
  .analytics-privacy button:not(:disabled):active {
    background: rgb(23 43 77 / 16%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .analytics-privacy button:not(:disabled):active {
      scale: 0.96;
    }
  }
  .analytics-privacy button:focus-visible {
    outline: 3px solid var(--ipc-color-ink);
    outline-offset: 3px;
  }
</style>
