---
import Breadcrumbs from "#src/components/Breadcrumbs.astro";
import SiteLayout from "#src/layouts/SiteLayout.astro";
import "#src/styles/civic-ledger.css";

const { data, topicLabel, topicSlug, description } = Astro.props as {
  data: {
    agencyName: string;
    agencyPath: string;
    administrativeArea: string;
    administrativeAreaSlug: string;
    categoryLabel: string;
    categorySlug: string;
    placeLabel: string;
    placePath: string;
  };
  description: string;
  topicLabel: string;
  topicSlug: string;
};

const toDisplayName = (value: string) =>
  value === value.toUpperCase()
    ? value
        .toLocaleLowerCase("en-US")
        .replace(/\b[a-z]/g, (letter) => letter.toLocaleUpperCase("en-US"))
    : value;
const agencyDisplayName = toDisplayName(data.agencyName);
const pagePath = `${data.agencyPath}${topicSlug}/`;
---

<SiteLayout
  title={`${agencyDisplayName} ${topicLabel} | PoliceConduct.org`}
  description={description}
  pagePath={pagePath}
>
  <main class="civic-index-page">
    <section class="civic-index-page-main">
      <div class="container">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: data.categoryLabel, href: `/${data.categorySlug}/` },
            {
              label: data.administrativeArea,
              href: `/${data.categorySlug}/${data.administrativeAreaSlug}/`,
            },
            { label: data.placeLabel, href: data.placePath },
            { label: agencyDisplayName, href: data.agencyPath },
            { label: topicLabel, href: pagePath, current: true },
          ]}
          className="mb-2"
        />

        <section class="civic-lede">
          <p class="civic-kicker">{agencyDisplayName}</p>
          <h1>{topicLabel}</h1>
          <p class="civic-lede-sub">{description}</p>
        </section>

        <section class="civic-section civic-section--last">
          <slot />
        </section>
      </div>
    </section>
  </main>
</SiteLayout>
