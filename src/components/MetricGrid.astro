---
import MetricCard from "#src/components/MetricCard.astro";
import type { MetricCardItem } from "#src/components/metric-card-types.js";

const { metrics, columns = "auto" } = Astro.props as {
  metrics: MetricCardItem[];
  columns?: "auto" | "four" | "five";
};
---

<div class:list={["entity-metric-grid", `entity-metric-grid-${columns}`]}>
  {metrics.map((metric) => <MetricCard metric={metric} />)}
</div>

<style>
  /* A framed ledger band, not a wall of cards. */
  .entity-metric-grid {
    border-top: 1px solid var(--ipc-color-rule);
    border-bottom: 1px solid var(--ipc-color-rule);
    column-gap: clamp(1.25rem, 1rem + 1.5vw, 2.75rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-bottom: 1.75rem;
    padding: 1.2rem 0;
    row-gap: 1.3rem;
  }

  @media (min-width: 768px) {
    .entity-metric-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .entity-metric-grid-auto {
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }

    .entity-metric-grid-four {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .entity-metric-grid-five {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
