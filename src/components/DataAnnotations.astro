---
import {
  parseAnnotations,
  annotationDisplay,
  annotationNoteLabel,
} from "#src/lib/data/annotation-values.js";
interface Props {
  annotations: unknown;
  field?: string;
}
const { annotations, field } = Astro.props;
const entries = parseAnnotations(annotations).filter(
  (entry) => field === undefined || entry.field === field,
);
---

{entries.length > 0 && (
  <ul class="list-unstyled mb-0">
    {entries.map((entry) => (
      <li class="mt-2">
        <strong>{annotationNoteLabel(entry)}:</strong>{" "}
        {annotationDisplay(entry).message}
      </li>
    ))}
  </ul>
)}
