---
// Wrapping ledger register for a row of <StatCell> metric tiles. Port of
// mockups/civic-index-redesign/texas-v9.html + shared-v5.css (.stat-strip).
//
// `drillFirst` applies the geography "Start here" treatment (teal wash on
// the leading drill cell via CSS `order`, see .stat-strip--drill-first /
// .stat-cell--drill in src/styles/civic-ledger.css) for state,
// administrative-area, and place landing pages. `columns` selects the
// non-drill grid variants already used by agency/federal pages.
interface Props {
  ariaLabel: string;
  drillFirst?: boolean;
  columns?: "four-plus-jump" | "three-plus-jump" | "five" | "four";
}

const { ariaLabel, drillFirst = false, columns = "four-plus-jump" } =
  Astro.props;
---

<section
  class:list={[
    "stat-strip",
    { "stat-strip--drill-first": drillFirst },
    { "stat-strip--three": columns === "three-plus-jump" },
    { "stat-strip--equal5": columns === "five" },
    { "stat-strip--even": columns === "four" },
  ]}
  aria-label={ariaLabel}
>
  <slot />
</section>
