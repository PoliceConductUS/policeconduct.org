---
import CivilCaseScopeNote from "#src/components/CivilCaseScopeNote.astro";
import EntityActionBar from "#src/components/EntityActionBar.astro";
import Pagination from "#src/components/Pagination.astro";
import PageShell from "#src/layouts/PageShell.astro";
import {
  CIVIL_CASES_PAGE_SIZE,
  loadCivilCaseList,
  type CivilCaseListItem,
} from "#src/lib/data/civil-cases.js";
import { formatLongDate } from "#src/lib/format.js";

type PaginatedCivilCasesPage = {
  data: CivilCaseListItem[];
  currentPage: number;
  lastPage: number;
};

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const civilCases = await loadCivilCaseList();
  return paginate(civilCases, {
    pageSize: CIVIL_CASES_PAGE_SIZE,
  }).filter((page: any) => {
    const pageParam = page.params?.page;
    if (Array.isArray(pageParam)) {
      return pageParam.length > 0 && pageParam[0] !== "1";
    }
    return (
      typeof pageParam === "string" && pageParam.length > 0 && pageParam !== "1"
    );
  });
}

const { page } = Astro.props as { page: PaginatedCivilCasesPage };
const pagePath = `/civil-cases/page/${page.currentPage}/`;
const title = `Civil cases - Page ${page.currentPage}`;
const pageDescription =
  "Civil litigation records involving law enforcement, sorted by filing date.";
---

<PageShell
  title={`${title} | PoliceConduct.org`}
  description={pageDescription}
  pagePath={pagePath}
  canonicalUrl={pagePath}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Civil cases", href: "/civil-cases/" },
    { label: `Page ${page.currentPage}`, href: pagePath, current: true },
  ]}
  heading={title}
  lede={pageDescription}
>
  <Fragment slot="actions">
    <EntityActionBar
      actions={[{ label: "Submit civil case", href: "/civil-cases/new/" }]}
    />
  </Fragment>

  <section class="civic-section civic-section--last">
    <div class="profile-record-list">
      {
        page.data.map((caseItem) => (
          <article class="profile-record">
            <div class="profile-record-meta">
              <span>{formatLongDate(caseItem.filed_date)}</span>
              {caseItem.court ? <span>{caseItem.court}</span> : null}
            </div>
            <div class="profile-record-body">
              <h2 class="profile-record-title">
                <a href={`/civil-cases/${caseItem.slug}/`}>{caseItem.title}</a>
              </h2>
              <div class="profile-record-detail">
                {caseItem.cause_number ? (
                  <span>{caseItem.cause_number}</span>
                ) : null}
                {caseItem.claims_summary ? (
                  <span>{caseItem.claims_summary}</span>
                ) : null}
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <Pagination
      basePath="/civil-cases/"
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
    <CivilCaseScopeNote />
  </section>
</PageShell>
<style>
  .profile-record-list {
    background: #fbfcff;
    border: 1px solid #d5deeb;
    border-radius: 0.45rem;
    box-shadow: 0 1px 2px rgba(7, 24, 66, 0.04);
    display: grid;
    gap: 0;
    overflow: hidden;
  }

  .profile-record {
    align-items: start;
    border-top: 1px solid #d9e1ee;
    display: grid;
    gap: 0.75rem 1.25rem;
    grid-template-columns: minmax(0, 1fr) minmax(10rem, 18rem);
    padding: 0.9rem 1.1rem;
    transition:
      background-color 140ms ease,
      border-color 140ms ease;
  }

  .profile-record:first-child {
    border-top: 0;
  }

  .profile-record:hover {
    background: #f7f9fc;
  }

  .profile-record-body {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }

  .profile-record-meta {
    align-items: flex-end;
    color: #33456f;
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    gap: 0.25rem;
    grid-column: 2;
    grid-row: 1;
    line-height: 1.35;
    min-width: 0;
    text-align: right;
  }

  .profile-record-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .profile-record-title a,
  .profile-record-detail a {
    color: #071842;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .profile-record-detail {
    color: #33456f;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.875rem;
    gap: 0.35rem 0.85rem;
    line-height: 1.5;
    margin-top: 0.35rem;
    min-width: 0;
  }

  .profile-record-title,
  .profile-record-detail,
  .profile-record-meta {
    overflow-wrap: anywhere;
  }

  @media (max-width: 991.98px) {
    .profile-record {
      grid-template-columns: minmax(0, 1fr);
    }

    .profile-record-body,
    .profile-record-meta {
      grid-column: 1;
    }

    .profile-record-meta {
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
      grid-row: 2;
      text-align: left;
    }
  }

  @media (max-width: 575.98px) {
    .profile-record-detail {
      align-items: flex-start;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
