---
import PageShell from "#src/layouts/PageShell.astro";
import { buildWebPage, getSiteUrl } from "#src/lib/structured-data.js";

type FaqEntry = {
  id: string;
  question: string;
  answerHtml: string;
  open?: true;
};

type FaqSection = {
  title: string;
  accordionId: string;
  entries: FaqEntry[];
};

const pagePath = "/frequently-asked-questions/";
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = new URL(pagePath, siteUrl).toString();
const faqSections: FaqSection[] = [
  {
    title: "About PoliceConduct.org",
    accordionId: "faqAccordionOverview",
    entries: [
      {
        id: "faqOverviewWhat",
        question: "What is PoliceConduct.org?",
        answerHtml:
          "PoliceConduct.org is a public-interest website for documenting police encounters, positive, negative, and everything in between, using a structured format that encourages clarity, evidence, and accountability.",
        open: true,
      },
      {
        id: "faqOverviewAntiPolice",
        question: "Is this an anti-police site?",
        answerHtml:
          "No. PoliceConduct.org is pro good policing. The goal is to recognize officers who serve professionally and respectfully, while also documenting conduct that harms public trust or violates rights.",
      },
      {
        id: "faqOverviewLaunch",
        question: "What's the launch status?",
        answerHtml:
          "This is a quiet opening. The site is live, but growth is intentionally slow while reporting, privacy safeguards, and corrections workflows mature.",
      },
      {
        id: "faqOverviewToday",
        question: "What's on the site today?",
        answerHtml:
          "The first published report is the founder's account of an encounter in Irving, Texas involving Irving Police Officer James Markham.",
      },
    ],
  },
  {
    title: "Submission and tracking",
    accordionId: "faqAccordionTracking",
    entries: [
      {
        id: "faqAccount",
        question: "Do I need to create an account to file a report?",
        answerHtml:
          "No. You do not need an account. After you submit, you receive a unique Submission ID. Keep it safe because it is required for follow-up and cannot be recovered or displayed again.",
        open: true,
      },
      {
        id: "faqAnonymous",
        question: "Do you accept anonymous reports?",
        answerHtml:
          "Yes. We accept anonymous submissions. Include dates, locations, agencies, incident numbers, witnesses, or evidence links whenever possible.",
      },
      {
        id: "faqStatus",
        question: "How can I check the status of my report or request changes?",
        answerHtml:
          "Email hello@policeconduct.org and include your Submission ID, your requested update or question, and the email or phone number you used in the original submission.",
      },
      {
        id: "faqTimeline",
        question: "How long does it take for my report to appear on the site?",
        answerHtml:
          "We are currently working through a backlog, so please allow at least one week for publication.",
      },
      {
        id: "faqRoleSelect",
        question: "Which role should I select for my report?",
        answerHtml:
          "Choose the role that best matches your connection to the event: Primary Participant if it happened to you, Witness if you saw it happen, Representative if you are filing for someone else, Legal/Professional Advocate if you are reporting as part of a case, or Concerned Citizen if you are reporting based on secondary evidence.",
      },
      {
        id: "faqRoleLawyer",
        question: "I am a lawyer filing for a client. Which role should I use?",
        answerHtml:
          "Select Legal/Professional Advocate or Representative, then use the description field to clarify your professional relationship to the participant while honoring their privacy preferences.",
      },
      {
        id: "faqLostId",
        question: "What happens if I forget my Submission ID?",
        answerHtml:
          "Submission IDs are not recoverable and cannot be displayed again. Submit the form again and include a note that it is a duplicate or follow-up.",
      },
    ],
  },
  {
    title: "Reporting standards",
    accordionId: "faqAccordionStandards",
    entries: [
      {
        id: "faqEvidenceForward",
        question: "What do you mean by evidence-forward?",
        answerHtml:
          "We separate personal accounts (what someone says happened), supporting materials (video, documents, public records), and opinion or analysis (clearly labeled). The goal is a usable record that can be evaluated and improved over time.",
        open: true,
      },
      {
        id: "faqWhyReport",
        question: "Why should the public report police experiences at all?",
        answerHtml:
          "Police encounters can have enormous consequences, and the public deserves a realistic way to describe what happened. A respectful, professional stop deserves recognition. A dehumanizing or retaliatory encounter deserves scrutiny. The in-between is often where patterns start to show.",
      },
      {
        id: "faqPublicRightNow",
        question: "What do you want from the public right now?",
        answerHtml:
          "Two things: report positive experiences so great officers are recognized and professionalism is normalized, and report negative or concerning experiences with as much specificity and documentation as possible.",
      },
    ],
  },
  {
    title: "Privacy and safety",
    accordionId: "faqAccordion",
    entries: [
      {
        id: "faqSix",
        question: "How do you handle privacy?",
        answerHtml:
          "We avoid unnecessary personally identifying information, especially about private individuals. Reports focus on conduct, context, and specific details, not doxxing. If you have specific privacy concerns, add a note in your submission and our team will follow up.",
        open: true,
      },
      {
        id: "faqPublicName",
        question: "Will my name be visible to the public?",
        answerHtml:
          "Reports are published anonymously by default. If you want attribution on a published report, contact our team and we will confirm your preference.",
      },
      {
        id: "faqNine",
        question: "What if police retaliate after I submit a report?",
        answerHtml:
          "If you believe there has been retaliation, file another report about that incident. Retaliation should not go unreported.",
      },
      {
        id: "faqSeven",
        question: "Are you associated with law enforcement?",
        answerHtml:
          "No. PoliceConduct.org is independent and not affiliated with law enforcement agencies or government entities.",
      },
      {
        id: "faqFive",
        question:
          "Can I include personally identifiable information in a report?",
        answerHtml:
          "Yes, but it will be redacted before publication. We do not allow doxxing of anyone, including yourself, witnesses, or officers.",
      },
    ],
  },
  {
    title: "Scope",
    accordionId: "faqAccordionScope",
    entries: [
      {
        id: "faqOne",
        question: "What types of experiences can I report?",
        answerHtml:
          "You can report any law enforcement experience: good (de-escalation, professionalism, fairness), bad (harassment, retaliation, unnecessary escalation), and everything in between. If it involved an officer or agency, it belongs here.",
        open: true,
      },
      {
        id: "faqTwo",
        question:
          "Can I report federal officers or agencies like the FBI, CIA, or ICE?",
        answerHtml:
          "Yes. Federal officers and agencies are included. Submit the report with as much detail as you can.",
      },
      {
        id: "faqThree",
        question: "How far back can I go when submitting a report?",
        answerHtml: "You can submit reports for experiences from any time.",
      },
      {
        id: "faqFour",
        question: "What if I do not know the officer’s name?",
        answerHtml:
          "That is okay. Share any identifying details you remember and one of our volunteers will do their best to identify the officer.",
      },
    ],
  },
  {
    title: "Evidence and details",
    accordionId: "faqAccordionEvidence",
    entries: [
      {
        id: "faqApproxTime",
        question:
          "What if I cannot remember the exact date or time of the incident?",
        answerHtml:
          "Provide the most accurate estimate you can. If you have photos or digital files, checking file info or metadata can help confirm the date, time, and location.",
        open: true,
      },
      {
        id: "faqOldIncident",
        question:
          "Can I submit a report for an incident that happened years ago?",
        answerHtml:
          "Yes. You can submit reports for experiences from any time.",
      },
      {
        id: "faqMultipleVideos",
        question: "I have multiple videos. Should I submit multiple reports?",
        answerHtml:
          "Please submit a single report for the full experience and include all relevant files or links. This keeps the materials for one experience together.",
      },
      {
        id: "faqVideoLink",
        question: "I have a video of the incident. How should I include it?",
        answerHtml:
          "Add a hosted link in the Evidence Links section (Google Drive, Dropbox, YouTube, iCloud, etc.). Make sure sharing is set to “Anyone with the link can view” so the linked material is accessible.",
      },
      {
        id: "faqWitnessInfo",
        question: "Should I include witness contact information?",
        answerHtml:
          "If a witness agrees to be contacted, include their name and contact details in the Witnesses section. We do not publish witness contact information.",
      },
    ],
  },
  {
    title: "Witnesses",
    accordionId: "faqAccordionWitnesses",
    entries: [
      {
        id: "faqOnBehalf",
        question: "Can I report on behalf of someone else?",
        answerHtml:
          "Yes. You may submit as a witness or on behalf of a family member or friend. Please explain your relationship to the incident in the description.",
        open: true,
      },
      {
        id: "faqWitnessOnly",
        question: "What if I was a witness and not directly involved?",
        answerHtml:
          "Witness reports are valuable and can corroborate a primary account. Note in your description that you are reporting as a witness.",
      },
    ],
  },
  {
    title: "Safety and legal",
    accordionId: "faqAccordionLegal",
    entries: [
      {
        id: "faqEight",
        question: "Can I get in trouble for submitting a report?",
        answerHtml:
          "In general, reporting your experience is protected speech, similar to leaving a review. We cannot guarantee outcomes in every situation, so please submit only truthful information.",
        open: true,
      },
      {
        id: "faqLegalCase",
        question: "Will filing a report affect an ongoing legal case?",
        answerHtml:
          "Sharing information publicly can affect legal proceedings. If you have an active case, consider consulting an attorney before publishing details.",
      },
      {
        id: "faqDefamationRisk",
        question: "How do you reduce defamation risk?",
        answerHtml:
          "We focus on specific, factual descriptions, label allegations versus documentation versus opinion, encourage supporting materials, and maintain a correction process. Reports avoid unnecessary personal details and center on public-interest conduct.",
      },
      {
        id: "faqLegalAdvice",
        question: "Is this legal advice?",
        answerHtml:
          "No. PoliceConduct.org is a documentation and public-interest project. Nothing on the site is legal advice.",
      },
    ],
  },
  {
    title: "Platform integrity",
    accordionId: "faqAccordionIntegrity",
    entries: [
      {
        id: "faqReceived",
        question: "How do I know my report was received?",
        answerHtml:
          "After submission, the page shows your Submission ID. Save it in a safe place. You need it for follow-up, and it cannot be recovered or displayed again.",
        open: true,
      },
      {
        id: "faqMistake",
        question: "What's your corrections policy?",
        answerHtml:
          "If someone identifies a specific factual error and provides credible evidence, we will correct it. If a dispute cannot be resolved quickly, the entry is updated to reflect the dispute and the evidence available on all sides. Use the Report Issue link in the footer to request a correction.",
      },
      {
        id: "faqResponses",
        question: "Can officers or agencies respond?",
        answerHtml:
          "Yes. PoliceConduct.org supports responses, clarifications, and additional documentation. If new credible information changes a report, we aim to update it prominently.",
      },
      {
        id: "faqRejected",
        question: "Why might a report not be published?",
        answerHtml:
          "We aim to publish every report, but submissions may be rejected or heavily redacted if they include hate speech, spam, or private information about uninvolved third parties.",
      },
    ],
  },
  {
    title: "Donations and nonprofit status",
    accordionId: "faqAccordionDonations",
    entries: [
      {
        id: "faqDelaware",
        question: "Why are you a national nonprofit, and why Delaware?",
        answerHtml:
          "Police conduct is a national issue, and we operate a centralized, secure database for all 50 states. We are incorporated in Delaware as a 501(c)(3) and comply with the solicitation laws of the states where we actively fundraise.",
        open: true,
      },
      {
        id: "faqDonationUse",
        question: "Does my donation go to a specific state or city?",
        answerHtml:
          "Donations go into our general fund to support the national platform.",
      },
      {
        id: "faqDonationTax",
        question: "Are donations tax-deductible?",
        answerHtml:
          "Yes. We are a 501(c)(3) nonprofit, so donations are tax-deductible to the fullest extent permitted by law.",
      },
      {
        id: "faqDonationHow",
        question: "How can I donate?",
        answerHtml:
          'Visit our donation page at <a href="/donate/">policeconduct.org/donate</a> for current ways to support the project.',
      },
      {
        id: "faqDonationProcessing",
        question: "How is my donation processed?",
        answerHtml:
          "We use Stripe for secure, encrypted donation processing and receive reduced nonprofit transaction fees through Stripe’s Nonprofit Excellence Program. This keeps overhead low so more of your gift funds the national platform. You will receive an automated tax receipt by email immediately after your donation is processed.",
      },
    ],
  },
  {
    title: "Process",
    accordionId: "faqAccordionProcess",
    entries: [
      {
        id: "faqTen",
        question:
          "Can my report be turned into an official complaint or commendation?",
        answerHtml:
          "Not yet. We plan to support official complaint and commendation workflows in the future.",
      },
    ],
  },
];
const toPlainText = (html: string) => html.replace(/<[^>]+>/g, "");
const structuredData = buildWebPage({
  siteUrl,
  pageUrl,
  name: "FAQ | PoliceConduct.org",
  description: "Frequently asked questions about PoliceConduct.org.",
  type: "FAQPage",
});
structuredData.mainEntity = faqSections
  .flatMap((section) => section.entries)
  .map((entry) => ({
    "@type": "Question",
    name: entry.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: toPlainText(entry.answerHtml),
    },
  }));
---

<PageShell
  title="FAQ | PoliceConduct.org"
  description="Frequently asked questions about PoliceConduct.org."
  pagePath={pagePath}
  canonicalUrl={pagePath}
  structuredData={structuredData}
  breadcrumbs={[
    { label: "Home", href: "/" },
    {
      label: "Frequently Asked Questions",
      href: pagePath,
      current: true,
    },
  ]}
  heading="Frequently Asked Questions"
>
  {faqSections.map((section, sectionIndex) => (
    <>
      <h2 class="ipc-section-title text-uppercase text-muted mb-3">
        {section.title}
      </h2>
      <div
        class={
          sectionIndex === faqSections.length - 1
            ? "accordion"
            : "accordion mb-5"
        }
        id={section.accordionId}
      >
        {section.entries.map((entry) => (
          <div class="accordion-item">
            <h2 class="accordion-header" id={entry.id}>
              <button
                class={
                  entry.open ? "accordion-button" : "accordion-button collapsed"
                }
                type="button"
                data-bs-toggle="collapse"
                data-bs-target={`#${entry.id}Panel`}
                aria-expanded={entry.open ? "true" : "false"}
                aria-controls={`${entry.id}Panel`}
              >
                {entry.question}
              </button>
            </h2>
            <div
              id={`${entry.id}Panel`}
              class={
                entry.open
                  ? "accordion-collapse collapse show"
                  : "accordion-collapse collapse"
              }
              aria-labelledby={entry.id}
              data-bs-parent={`#${section.accordionId}`}
            >
              <div class="accordion-body" set:html={entry.answerHtml} />
            </div>
          </div>
        ))}
      </div>
    </>
  ))}
</PageShell>
