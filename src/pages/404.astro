---
import PageShell from "#src/layouts/PageShell.astro";
---

<PageShell
  title="Page Not Found | PoliceConduct.org"
  description="PoliceConduct.org page not found."
  pagePath="/404/"
  canonicalUrl="/404/"
  robots="noindex,follow"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Page not found", href: "/404/", current: true },
  ]}
  heading="Page not found"
  lede="We could not find that page. The link may have changed, or the page may no longer be available."
>
  <Fragment slot="actions">
    <a class="btn btn-dark rounded-0" href="/">Go home</a>
    <a class="btn btn-outline-dark rounded-0" href="/find-records/">
      Find Records
    </a>
    <a
      class="btn btn-outline-dark rounded-0"
      href="#report-issue"
      id="report-issue-link"
    >
      Report a site issue
    </a>
  </Fragment>

  <script is:inline>
    (function () {
      const link = document.getElementById("report-issue-link");
      if (!link) {
        return;
      }
      const message = `Page not found: ${window.location.href}`;
      link.setAttribute("data-issue-message", message);
    })();
  </script>
</PageShell>
