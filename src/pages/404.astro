---
import PageShell from "#src/layouts/PageShell.astro";
---

<PageShell
  title="Page Not Found | PoliceConduct.org"
  description="PoliceConduct.org page not found."
  pagePath="/404/"
  canonicalUrl="/404/"
  robots="noindex,follow"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Page not found", href: "/404/", current: true },
  ]}
  heading="Page not found"
  lede="We could not find that page. The link may have changed, or the page may no longer be available."
>
  <Fragment slot="actions">
    <a class="btn btn-dark rounded-0" href="/">
      Go home
    </a>
    <a
      class="btn btn-outline-dark rounded-0"
      href="/find-records/"
      id="find-records-link"
    >
      Find records
    </a>
    <a
      class="btn btn-outline-dark rounded-0"
      href="/about/contact/"
      id="report-issue-link"
    >
      Report a site issue
    </a>
  </Fragment>

  <script is:inline>
    (function () {
      const link = document.getElementById("report-issue-link");
      if (!link) {
        return;
      }
      const message = `Page not found: ${window.location.href}`;
      link.setAttribute("data-issue-message", message);
    })();

    // Offer a search for the words in the address that was not found, such as
    // "irving police department" from /tx/.../irving-police-department-049f9a/.
    (function () {
      const findLink = document.getElementById("find-records-link");
      // Path words that name a section of the site, not a place or agency.
      // Two-letter state codes are skipped by length.
      const sectionNames = [
        "404",
        "agencies",
        "budget",
        "civil-cases",
        "counties",
        "fatal-force-incidents",
        "federal",
        "liability-costs",
        "licensing-authority",
        "outcomes-by-income",
        "page",
        "personnel",
        "places",
        "reports",
      ];
      const segment = window.location.pathname
        .split("/")
        .filter(Boolean)
        .reverse()
        .find(
          (part) =>
            part.length > 2 &&
            /[a-z]/i.test(part) &&
            !sectionNames.includes(part),
        );
      if (!findLink || !segment) {
        return;
      }
      let words;
      try {
        words = decodeURIComponent(segment);
      } catch (_error) {
        return;
      }
      words = words
        .replace(/-[0-9a-f]{6}$/, "")
        .replace(/[^\p{L}\p{N}]+/gu, " ")
        .trim()
        .slice(0, 60);
      if (!words) {
        return;
      }
      findLink.setAttribute(
        "href",
        `/find-records/?q=${encodeURIComponent(words)}`,
      );
      findLink.textContent = `Find records for \u201c${words}\u201d`;
    })();
  </script>
</PageShell>
