---
import ReportArchivePage from "#src/components/ReportArchivePage.astro";
import { buildReportArchiveStaticPaths } from "#src/lib/data/report-archives.js";
import { loadReportSummaries } from "#src/lib/data/summaries.js";

export async function getStaticPaths() {
  return buildReportArchiveStaticPaths(
    await loadReportSummaries(),
    "county",
  ).map(({ params }) => ({ params }));
}

const archive = buildReportArchiveStaticPaths(
  await loadReportSummaries(),
  "county",
).find((candidate) => candidate.props.pagePath === Astro.url.pathname);
if (!archive) {
  throw new Error(`No report archive has the path ${Astro.url.pathname}.`);
}
const { breadcrumbs, pagePath, reports, title } = archive.props;
---

<ReportArchivePage
  breadcrumbs={breadcrumbs}
  pagePath={pagePath}
  reports={reports}
  title={title}
/>
