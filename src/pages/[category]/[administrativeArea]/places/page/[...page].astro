---
import type { GetStaticPathsOptions, GetStaticPathsResult } from "astro";
import CivicChildIndexPage from "#src/components/CivicChildIndexPage.astro";
import { buildAdministrativeAreaCivicIndex } from "#src/lib/data/civic-index.js";
import {
  loadAdministrativeAreaScopedPaths,
  loadRequiredLocationByPath,
} from "#src/lib/data/civic-scoped-routes.js";
import { PAGE_SIZE } from "#src/lib/pagination.js";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const paths = await loadAdministrativeAreaScopedPaths();
  const pages: GetStaticPathsResult = [];

  for (const path of paths) {
    const model = await buildAdministrativeAreaCivicIndex(
      await loadRequiredLocationByPath(
        `/${path.params.category}/${path.params.administrativeArea}/`,
        "administrative_area",
      ),
    );
    paginate(model.rows, {
      pageSize: PAGE_SIZE,
      params: path.params,
      props: {
        label: "Places",
        model,
        pagePath: `${model.pagePath}places/`,
      },
    })
      .filter((page) => {
        const pageParam = page.params?.page;
        if (Array.isArray(pageParam)) {
          return pageParam.length > 0 && pageParam[0] !== "1";
        }
        return (
          typeof pageParam === "string" &&
          pageParam.length > 0 &&
          pageParam !== "1"
        );
      })
      .forEach((page) => pages.push(page));
  }

  return pages;
}

const { label, model, page, pagePath } = Astro.props;
---

<CivicChildIndexPage
  label={label}
  model={model}
  page={page}
  pagePath={pagePath}
/>
