---
import AgencyPersonnelList from "#src/components/AgencyPersonnelList.astro";
import Pagination from "#src/components/Pagination.astro";
import PageShell from "#src/layouts/PageShell.astro";
import { timeBuildStep } from "#src/lib/build-timing.js";
import {
  loadAgencyDetailByRouteParams,
  loadAgencyLocationStaticPathsForTopic,
} from "#src/lib/data/agency-detail.js";
import { PAGE_SIZE } from "#src/lib/pagination.js";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return timeBuildStep("agency personnel pagination static paths", async () => {
    const agencyPaths =
      await loadAgencyLocationStaticPathsForTopic("personnel");
    const pages: any[] = [];

    for (const agencyPath of agencyPaths) {
      const data = await loadAgencyDetailByRouteParams(agencyPath.params);
      paginate(data.employees, {
        pageSize: PAGE_SIZE,
        params: agencyPath.params,
      })
        .filter((page: any) => {
          const pageParam = page.params?.page;
          if (Array.isArray(pageParam)) {
            return pageParam.length > 0 && pageParam[0] !== "1";
          }
          return (
            typeof pageParam === "string" &&
            pageParam.length > 0 &&
            pageParam !== "1"
          );
        })
        .forEach((page: any) => pages.push(page));
    }

    return pages;
  });
}

const { page } = Astro.props;
const data = await loadAgencyDetailByRouteParams(Astro.params);
const {
  agencyName,
  agencyPath,
  categoryLabel,
  categorySlug,
  administrativeArea,
  placeLabel,
  placePath,
  employees,
} = data;

const pagePath = `${agencyPath}personnel/page/${page.currentPage}/`;
const personnelIndexPath = `${agencyPath}personnel/`;
const pageTitle = `${agencyName} Personnel - Page ${page.currentPage}`;
const formatCount = (value: number) => value.toLocaleString("en-US");
const pageDescription = `${formatCount(employees.length)} current and former personnel records for ${agencyName}, sorted by name, from state licensing data.`;
---

<PageShell
  title={pageTitle}
  description={pageDescription}
  pagePath={pagePath}
  canonicalUrl={pagePath}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: categoryLabel, href: `/${categorySlug}/` },
    {
      label: administrativeArea,
      href: `/${categorySlug}/${data.administrativeAreaSlug}/`,
    },
    { label: placeLabel, href: placePath },
    { label: agencyName, href: agencyPath },
    { label: "Personnel", href: personnelIndexPath },
    { label: `Page ${page.currentPage}`, href: pagePath, current: true },
  ]}
  heading={`${agencyName} Personnel`}
  lede={pageDescription}
>
  <section class="civic-section civic-section--last">
    <AgencyPersonnelList employees={page.data} />
    <Pagination
      basePath={personnelIndexPath}
      currentPage={page.currentPage}
      lastPage={page.lastPage}
    />
    <p class="civic-limit-note">
      Personnel records come from state licensing data. A listing here is
      employment history, not an allegation.
    </p>
  </section>
</PageShell>
