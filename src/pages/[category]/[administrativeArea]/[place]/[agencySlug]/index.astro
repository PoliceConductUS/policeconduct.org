---
import Breadcrumbs from "#src/components/Breadcrumbs.astro";
import "#src/styles/civic-ledger.css";
import EntityActionButton from "#src/components/EntityActionButton.astro";
import PrefillBootstrap from "#src/components/PrefillBootstrap.astro";
import PrefillNavButton from "#src/components/PrefillNavButton.astro";
import SiteLayout from "#src/layouts/SiteLayout.astro";
import {
  loadAgencyDetailByRouteParams,
  loadAgencyLocationStaticPaths,
} from "#src/lib/data/agency-detail.js";
import type { ReportNewPrefill } from "#src/lib/forms/prefill";
import { getSiteUrl } from "#src/lib/structured-data.js";

export async function getStaticPaths() {
  return loadAgencyLocationStaticPaths();
}

const data = await loadAgencyDetailByRouteParams(Astro.params);

const {
  agencyName,
  agencyState,
  categorySlug,
  categoryLabel,
  agencyPath,
  administrativeArea,
  placeLabel,
  placePath,
  civilCases,
  counts,
} = data;
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = new URL(agencyPath, siteUrl).toString();
const profilePageId = `${pageUrl}#profilepage`;
const pageDescription = `${agencyName} agency profile with contact information, personnel, public reports, and recent civil litigation references.`;
const civilCaseTotal = counts.civilCases + counts.personnelLinkedCivilCases;
const addressAvailable =
  data.agency.address ||
  data.agency.city ||
  agencyState ||
  data.agency.zip_code;
const address = addressAvailable
  ? {
      "@type": "PostalAddress",
      addressCountry: "US",
      ...(data.agency.address ? { streetAddress: data.agency.address } : {}),
      ...(data.agency.city ? { addressLocality: data.agency.city } : {}),
      addressRegion: agencyState,
      ...(data.agency.zip_code ? { postalCode: data.agency.zip_code } : {}),
    }
  : null;
const contactPoints = data.agencyPhones.map(
  (phone: { phone_number: string; label?: string | null }) => ({
    "@type": "ContactPoint",
    telephone: phone.phone_number,
    ...(phone.label ? { contactType: phone.label } : {}),
  }),
);
const sameAs = data.agencyLinks
  .map((link: { url?: string | null }) => link.url)
  .filter(Boolean);
const agencyPrefillName = agencyName.toLocaleUpperCase("en-US");
const primaryWebsite =
  data.agencyLinks.find((link: { url?: string | null }) =>
    /^https?:\/\//i.test(link.url || ""),
  )?.url || "";
const agencyLinksSummary = data.agencyLinks
  .map((link: { label?: string | null; url?: string | null }) =>
    [link.label, link.url].filter(Boolean).join(": "),
  )
  .filter(Boolean)
  .join("\n");
const civilLitigationRecords = [
  ...civilCases.map((record: any) => ({
    ...record,
    caseUrl: `/civil-cases/${record.slug}/`,
  })),
  ...data.personnelLinkedCivilCases.map((record: any) => ({
    ...record,
    caseUrl: `/civil-cases/${record.slug}/`,
  })),
];
const civilLitigationSummary = civilLitigationRecords
  .map((record) => {
    const segments = [
      record.title || "Civil case",
      record.cause_number || null,
      record.court || null,
      record.caseUrl,
    ];
    return segments.filter(Boolean).join(" — ");
  })
  .join("\n");
const reportLinksSummary = data.reportedReports
  .map((report: { url: string }) => report.url)
  .join("\n");
const reportNewPrefillPayload = JSON.stringify({
  officer: {
    department: agencyPrefillName,
  },
} satisfies ReportNewPrefill);
const addCivilCasePrefillPayload = JSON.stringify({
  jurisdiction: categorySlug,
  defendants: agencyPrefillName,
  summary: `${agencyPrefillName} agency profile: ${agencyPath}`,
  links: [
    agencyPath,
    ...data.reportedReports
      .slice(0, 3)
      .map((report: { url: string }) => report.url),
  ]
    .filter(Boolean)
    .join("\n"),
});
const suggestEditPrefillPayload = JSON.stringify({
  agencyPath,
  agencyName: agencyPrefillName,
  jurisdiction: categorySlug,
  departmentWebsite: primaryWebsite,
  departmentHead: data.agency.contact_name || "",
  socialLinks: agencyLinksSummary,
  civilLitigation: civilLitigationSummary,
});
const suggestPersonnelPrefillPayload = JSON.stringify({
  currentAgency: agencyPrefillName,
  currentAgencyCity: data.agency.city || "",
  currentAgencyState: agencyState,
  civilLitigation: civilLitigationSummary,
  reportLinks: reportLinksSummary,
});
const subscribePrefillPayload = JSON.stringify({
  whoami: "Subscriber",
  message: `Please notify me when this agency page changes: ${agencyPath}`,
});
const claimProfilePrefillPayload = JSON.stringify({
  whoami: "Profile Owner",
  message: `I would like to claim ownership of this profile.\nProfile path: ${agencyPath}`,
});
const federalAgency = data.federalAgency
  ? {
      name: data.federalAgency.name,
      path: `/federal/${data.federalAgency.slug}/`,
    }
  : null;
const toDisplayName = (value: string) =>
  value === value.toUpperCase()
    ? value
        .toLocaleLowerCase("en-US")
        .replace(/\b[a-z]/g, (letter) => letter.toLocaleUpperCase("en-US"))
    : value;
const agencyDisplayName = toDisplayName(agencyName);
const cityDisplayName = data.agency.city
  ? toDisplayName(data.agency.city)
  : null;

const formatCount = (value: number) => value.toLocaleString("en-US");
const formatDate = (value: string | Date) =>
  new Date(value).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });

const addressLine = [
  data.agency.address,
  [cityDisplayName, (agencyState || "").toUpperCase()]
    .filter(Boolean)
    .join(", ") + (data.agency.zip_code ? ` ${data.agency.zip_code}` : ""),
]
  .filter(Boolean)
  .join(", ");
const primaryPhone = data.agencyPhones.find(
  (phone: { description?: string | null }) =>
    (phone.description || "").toLowerCase() !== "fax",
);
const updatedLine = data.agency.updated_at
  ? `Updated ${formatDate(data.agency.updated_at)}`
  : null;

const volunteerHref = `/volunteer/?ref=${encodeURIComponent(agencyPath)}`;
const personnelMeta =
  counts.currentPersonnel > 0 || counts.formerPersonnel > 0
    ? `${formatCount(counts.currentPersonnel)} current · ${formatCount(counts.formerPersonnel)} former`
    : null;

type RecentItem = {
  href: string;
  meta: string;
  title: string;
  sortDate: number;
};

const recentCaseItems: RecentItem[] = civilLitigationRecords
  .filter(
    (record, index, records) =>
      records.findIndex((entry) => entry.slug === record.slug) === index,
  )
  .map((record) => ({
    href: record.caseUrl,
    title: record.title || "Civil case",
    meta: [
      "Civil case",
      record.court || null,
      record.filed_date ? `Filed ${formatDate(record.filed_date)}` : null,
      record.outcome || null,
    ]
      .filter(Boolean)
      .join(" · "),
    sortDate: record.filed_date ? new Date(record.filed_date).getTime() : 0,
  }));
const recentReportItems: RecentItem[] = data.reportedReports.map(
  (report: { incidentDate: string; title?: string; url: string }) => ({
    href: report.url,
    title: report.title || "Public report",
    meta: `Report · Incident ${formatDate(report.incidentDate)}`,
    sortDate: new Date(report.incidentDate).getTime(),
  }),
);
const recentItems = [...recentCaseItems, ...recentReportItems]
  .sort((left, right) => right.sortDate - left.sortDate)
  .slice(0, 6);

const organization = {
  "@type": "GovernmentOrganization",
  "@id": `${pageUrl}#organization`,
  name: agencyName,
  url: pageUrl,
  mainEntityOfPage: { "@id": profilePageId },
  ...(address ? { address } : {}),
  ...(data.agency.contact_email ? { email: data.agency.contact_email } : {}),
  ...(contactPoints.length ? { contactPoint: contactPoints } : {}),
  ...(sameAs.length ? { sameAs } : {}),
  areaServed: { "@type": "AdministrativeArea", name: agencyState },
};
const websiteId = new URL("/", siteUrl).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: websiteId,
      name: "PoliceConduct.org",
    },
    {
      "@type": "ProfilePage",
      "@id": profilePageId,
      url: pageUrl,
      name: `${agencyName} | PoliceConduct.org`,
      description: pageDescription,
      isPartOf: { "@id": websiteId },
      mainEntity: { "@id": organization["@id"] },
      ...(data.agency.updated_at
        ? { dateModified: String(data.agency.updated_at) }
        : {}),
    },
    organization,
  ],
};
---

<SiteLayout
  title={`${agencyName} | PoliceConduct.org`}
  description={pageDescription}
  pagePath={agencyPath}
  structuredData={structuredData}
>
  <PrefillBootstrap />
  <main id="main" class="agency-overview-page flex-grow-1">
    <section class="agency-overview">
      <div class="container">
        <Breadcrumbs
          items={[
            { label: "Home", href: "/" },
            { label: categoryLabel, href: `/${categorySlug}/` },
            {
              label: administrativeArea,
              href: `/${categorySlug}/${data.administrativeAreaSlug}/`,
            },
            {
              label: placeLabel,
              href: placePath,
            },
            { label: agencyDisplayName, href: agencyPath, current: true },
          ]}
        />

        <section class="entity-hero">
          <div class="entity-hero-grid">
            <div>
              <p class="civic-kicker">Department profile</p>
              <h1>{agencyDisplayName}</h1>
              {
                federalAgency ? (
                  <p class="agency-overview-federal">
                    <span>Federal agency</span>
                    <a href={federalAgency.path}>{federalAgency.name}</a>
                  </p>
                ) : null
              }
              <div class="entity-contact">
                {
                  addressLine ? (
                    <address class="entity-address">{addressLine}</address>
                  ) : null
                }
                {
                  primaryPhone || data.agencyLinks.length ? (
                    <p class="entity-contact-links">
                      {primaryPhone ? (
                        <a href={`tel:${primaryPhone.phone_number}`}>
                          {primaryPhone.phone_number}
                        </a>
                      ) : null}
                      {data.agencyLinks.map(
                        (link: {
                          label?: string | null;
                          url?: string | null;
                        }) =>
                          link.url ? (
                            <a href={link.url} rel="noopener">
                              {link.label || link.url}
                            </a>
                          ) : null,
                      )}
                    </p>
                  ) : null
                }
                {
                  data.agency.contact_name || data.agency.contact_email ? (
                    // Contact name + email are linked in the data model —
                    // render as one visual group; phone and website links
                    // above must not sit between them.
                    <p class="entity-contact-person">
                      {data.agency.contact_name ? (
                        <>Contact: {toDisplayName(data.agency.contact_name)}</>
                      ) : (
                        "Contact:"
                      )}
                      {data.agency.contact_name && data.agency.contact_email ? (
                        <span class="sep" aria-hidden="true">
                          ·
                        </span>
                      ) : null}
                      {data.agency.contact_email ? (
                        <a href={`mailto:${data.agency.contact_email}`}>
                          {data.agency.contact_email}
                        </a>
                      ) : null}
                    </p>
                  ) : null
                }
              </div>
              <div class="entity-actions">
                <PrefillNavButton
                  to="/report/new/"
                  payload={reportNewPrefillPayload}
                  class="entity-action-button entity-action-primary"
                >
                  Share an interaction
                </PrefillNavButton>
                <PrefillNavButton
                  to="/agency/suggest-edit/"
                  payload={suggestEditPrefillPayload}
                  class="entity-action-button"
                >
                  Suggest edit
                </PrefillNavButton>
                <PrefillNavButton
                  to="/civil-cases/new/"
                  payload={addCivilCasePrefillPayload}
                  class="entity-action-button"
                >
                  Add a civil case
                </PrefillNavButton>
              </div>
              {updatedLine ? <p class="entity-updated">{updatedLine}</p> : null}
            </div>
            <aside class="entity-side">
              <p class="civic-kicker">Help improve this page</p>
              <h2>Add what is missing</h2>
              <ul class="entity-side-list">
                <li>
                  <span>Add personnel</span>
                  <PrefillNavButton
                    to="/personnel/new/"
                    payload={suggestPersonnelPrefillPayload}
                    aria-label="Suggest new personnel"
                    class="entity-side-link"
                  >
                    Start
                  </PrefillNavButton>
                </li>
                <li>
                  <span>Get updates</span>
                  <PrefillNavButton
                    to="/about/contact/"
                    payload={subscribePrefillPayload}
                    aria-label="Get updates"
                    data-testid="agency-subscribe-link"
                    class="entity-side-link"
                  >
                    Start
                  </PrefillNavButton>
                </li>
                <li>
                  <span>Claim this profile</span>
                  <PrefillNavButton
                    to="/about/contact/"
                    payload={claimProfilePrefillPayload}
                    aria-label="Claim this profile"
                    data-testid="agency-claim-profile-link"
                    class="entity-side-link"
                  >
                    Start
                  </PrefillNavButton>
                </li>
                <li>
                  <span>Download report</span>
                  <EntityActionButton
                    data-agency-download-report
                    aria-label="Download report"
                    class="entity-side-link"
                  >
                    Soon
                  </EntityActionButton>
                </li>
              </ul>
              <span class="agency-coming-soon" data-agency-coming-soon></span>
            </aside>
          </div>
        </section>

        <section
          class="stat-strip"
          aria-label={`${agencyDisplayName} record totals`}
        >
          {
            counts.personnel > 0 ? (
              <a
                class="stat-cell stat-cell--link"
                href={`${agencyPath}personnel/`}
              >
                <strong class="ledger-value">
                  {formatCount(counts.personnel)}
                </strong>
                <span class="ledger-label">Personnel Records</span>
                {personnelMeta ? (
                  <span class="ledger-meta">{personnelMeta}</span>
                ) : null}
                <span class="stat-action">View personnel →</span>
              </a>
            ) : (
              <div class="stat-cell is-pending">
                <strong class="ledger-value">--</strong>
                <span class="ledger-label">Personnel Records</span>
                <span class="stat-action">
                  <a href={volunteerHref}>Help collect →</a>
                </span>
              </div>
            )
          }
          {
            counts.reports > 0 ? (
              <a
                class="stat-cell stat-cell--link"
                href={`${agencyPath}reports/`}
              >
                <strong class="ledger-value">
                  {formatCount(counts.reports)}
                </strong>
                <span class="ledger-label">Reports</span>
                <span class="ledger-meta">Shared by the public</span>
                <span class="stat-action">View reports →</span>
              </a>
            ) : (
              <div class="stat-cell is-pending">
                <strong class="ledger-value">--</strong>
                <span class="ledger-label">Reports</span>
                <span class="stat-action">
                  <a href="/report/new/">Share an interaction →</a>
                </span>
              </div>
            )
          }
          {
            civilCaseTotal > 0 ? (
              <a
                class="stat-cell stat-cell--link"
                data-role="civil"
                href={`${agencyPath}civil-cases/`}
              >
                <strong class="ledger-value">
                  {formatCount(civilCaseTotal)}
                </strong>
                <span class="ledger-label">Civil Cases</span>
                <span class="ledger-meta">Court records</span>
                <span class="stat-action">View civil cases →</span>
              </a>
            ) : (
              <div class="stat-cell is-pending" data-role="civil">
                <strong class="ledger-value">--</strong>
                <span class="ledger-label">Civil Cases</span>
                <span class="stat-action">
                  <a href={volunteerHref}>Help collect →</a>
                </span>
              </div>
            )
          }
          <div class="stat-cell is-pending" data-role="budget">
            <strong class="ledger-value">--</strong>
            <span class="ledger-label">Budget</span>
            <span class="stat-action">
              <a href={volunteerHref}>Help collect this →</a>
            </span>
          </div>
          <div class="stat-cell is-pending" data-role="liability">
            <strong class="ledger-value">--</strong>
            <span class="ledger-label">Liability Costs</span>
            <span class="stat-action">
              <a href={volunteerHref}>Help collect this →</a>
            </span>
          </div>
        </section>

        <section class="civic-section civic-section--last">
          {
            recentItems.length ? (
              <>
                <div class="civic-section-head">
                  <div>
                    <h2>Recent reports and civil cases</h2>
                    <p>Most recent activity connected to this agency.</p>
                  </div>
                </div>
                <div class="recent-list">
                  {recentItems.map((item) => (
                    <a href={item.href}>
                      <span class="recent-list-title">{item.title}</span>
                      <span class="recent-list-meta">{item.meta}</span>
                    </a>
                  ))}
                </div>
              </>
            ) : null
          }
          <p class="civic-limit-note">
            Counts show items available on this site. They are not a rating.
          </p>
        </section>
      </div>
    </section>
  </main>

  <style>
    /* Page-specific overrides on the shared civic-ledger vocabulary. */
    .agency-overview :global(.stat-strip) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    @media (min-width: 900px) {
      .agency-overview :global(.entity-hero-grid) {
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.34fr);
      }
    }

    @media (max-width: 991.98px) {
      .agency-overview :global(.stat-strip) {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 575.98px) {
      .agency-overview :global(.stat-strip) {
        grid-template-columns: 1fr;
      }
    }
  </style>
  <script>
    const setComingSoon = (button: Element, message: string) => {
      const side = button.closest(".entity-side");
      const output = side?.querySelector("[data-agency-coming-soon]");
      if (output) output.textContent = message;
    };

    const trackAgencyInterest = (eventName: string) => {
      window.__IPC_ANALYTICS__?.track?.(eventName, {
        agency_path: window.location.pathname,
        page_path: window.location.pathname,
      });
    };

    document
      .querySelectorAll("[data-agency-download-report]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          trackAgencyInterest("agency_report_download_interest");
          setComingSoon(button, "Downloadable agency reports are coming soon.");
        });
      });
  </script>
</SiteLayout>
