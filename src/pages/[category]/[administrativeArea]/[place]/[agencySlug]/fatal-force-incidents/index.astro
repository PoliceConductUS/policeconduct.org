---
import AgencyTopicPage from "#src/components/AgencyTopicPage.astro";
import StatCell from "#src/components/StatCell.astro";
import { buildHelpCollectHref } from "#src/lib/data/civic-index.js";
import {
  loadAgencyDetailByRouteParams,
  loadAgencyLocationStaticPathsForTopic,
} from "#src/lib/data/agency-detail.js";

export async function getStaticPaths() {
  return loadAgencyLocationStaticPathsForTopic("fatal-force-incidents");
}

const data = await loadAgencyDetailByRouteParams(Astro.params);
const agencySlug = data.agencyPath.split("/").filter(Boolean).pop() || "";
const volunteerHref = buildHelpCollectHref(
  `${data.agencyPath}fatal-force-incidents/`,
  "agency",
  agencySlug,
);
---

<AgencyTopicPage
  data={data}
  topicLabel="Fatal Force Incidents"
  topicSlug="fatal-force-incidents"
  description="Deaths involving police contact connected to this agency, including custody and pursuit deaths."
>
  <ul class="topic-row">
    <StatCell
      variant="topic"
      label="Fatal Force Incidents"
      gloss="Deaths involving police"
      role="neutral"
      empty
      helpCollectHref={volunteerHref}
    />
  </ul>
</AgencyTopicPage>
