---
import AgencyReportsPage from "#src/components/AgencyReportsPage.astro";
import { timeBuildStep } from "#src/lib/build-timing.js";
import {
  loadAgencyDetailByRouteParams,
  loadAgencyLocationStaticPathsForTopic,
} from "#src/lib/data/agency-detail.js";
import { PAGE_SIZE } from "#src/lib/pagination.js";

// Enumerates params only. The render reloads the agency by its route params
// and pages its reports.
export async function getStaticPaths() {
  return timeBuildStep("agency reports pagination static paths", async () => {
    const agencyPaths = await loadAgencyLocationStaticPathsForTopic("reports");
    const pages: {
      params: (typeof agencyPaths)[number]["params"] & { page: string };
    }[] = [];

    for (const agencyPath of agencyPaths) {
      const data = await loadAgencyDetailByRouteParams(agencyPath.params);
      const lastPage = Math.ceil(data.reportedReports.length / PAGE_SIZE);
      for (let pageNumber = 2; pageNumber <= lastPage; pageNumber += 1) {
        pages.push({
          params: { ...agencyPath.params, page: String(pageNumber) },
        });
      }
    }

    return pages;
  });
}

const currentPage = Number(Astro.params.page);
if (String(currentPage) !== Astro.params.page || currentPage < 2) {
  throw new Error(`Invalid reports page number ${Astro.params.page}.`);
}
const data = await loadAgencyDetailByRouteParams(Astro.params);
const lastPage = Math.ceil(data.reportedReports.length / PAGE_SIZE);
if (currentPage > lastPage) {
  throw new Error(
    `Reports page ${currentPage} is past the last page ${lastPage}.`,
  );
}
const start = (currentPage - 1) * PAGE_SIZE;
---

<AgencyReportsPage
  currentPage={currentPage}
  data={data}
  lastPage={lastPage}
  pageReports={data.reportedReports.slice(start, start + PAGE_SIZE)}
/>
