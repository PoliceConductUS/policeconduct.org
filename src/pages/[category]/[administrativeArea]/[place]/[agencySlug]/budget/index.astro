---
import AgencyTopicPage from "#src/components/AgencyTopicPage.astro";
import {
  loadAgencyDetailByRouteParams,
  loadAgencyLocationStaticPathsForTopic,
} from "#src/lib/data/agency-detail.js";

export async function getStaticPaths() {
  return loadAgencyLocationStaticPathsForTopic("budget");
}

const data = await loadAgencyDetailByRouteParams(Astro.params);
const volunteerHref = `/volunteer/?ref=${encodeURIComponent(`${data.agencyPath}budget/`)}`;
---

<AgencyTopicPage
  data={data}
  topicLabel="Budget"
  topicSlug="budget"
  description="Budget, revenue, spending, forfeiture, and overtime records for this agency."
>
  <ul class="topic-row">
    <li class="topic-cell is-pending" data-role="budget">
      <span class="ledger-label">Budget</span>
      <span class="topic-value">Not yet available</span>
      <span class="topic-foot">
        <a href={volunteerHref}>Help collect this →</a>
      </span>
    </li>
  </ul>
  <p class="civic-limit-note">
    These records are not on this site yet. You can help request and review
    the source records.
  </p>
</AgencyTopicPage>
