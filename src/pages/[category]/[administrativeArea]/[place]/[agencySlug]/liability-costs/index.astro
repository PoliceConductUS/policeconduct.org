---
import AgencyTopicPage from "#src/components/AgencyTopicPage.astro";
import StatCell from "#src/components/StatCell.astro";
import { buildHelpCollectHref } from "#src/lib/data/civic-index.js";
import {
  loadAgencyDetailByRouteParams,
  loadAgencyLocationStaticPathsForTopic,
} from "#src/lib/data/agency-detail.js";

export async function getStaticPaths() {
  return loadAgencyLocationStaticPathsForTopic("liability-costs");
}

const data = await loadAgencyDetailByRouteParams(Astro.params);
const agencySlug = data.agencyPath.split("/").filter(Boolean).pop() || "";
const volunteerHref = buildHelpCollectHref(
  `${data.agencyPath}liability-costs/`,
  "agency",
  agencySlug,
);
---

<AgencyTopicPage
  data={data}
  topicLabel="Liability Costs"
  topicSlug="liability-costs"
  description="Claims, settlements, judgments, defense costs, and related payments for this agency."
>
  <ul class="topic-row">
    <StatCell
      variant="topic"
      label="Liability Costs"
      gloss="Payouts in police-conduct cases"
      role="liability"
      empty
      helpCollectHref={volunteerHref}
    />
  </ul>
</AgencyTopicPage>
