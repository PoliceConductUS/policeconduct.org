---
import PageShell from "#src/layouts/PageShell.astro";
import DataAnnotationIndex from "#src/components/DataAnnotationIndex.astro";
import { loadDataAnnotations } from "#src/lib/data/data-annotations.js";
import {
  loadStateAuthorityPaths,
  loadStateAuthority,
  loadAuthorityNamespaces,
} from "#src/lib/data/licensing-authority.js";
import {
  annotationPages,
  annotationFilters,
  annotationHref,
} from "#src/lib/data/annotation-views.js";
export async function getStaticPaths() {
  const entries = await loadDataAnnotations();
  return (
    await Promise.all(
      (await loadStateAuthorityPaths()).map(async ({ params }) => {
        const authority = await loadStateAuthority(`/${params.category}/`);
        const namespaces = await loadAuthorityNamespaces(authority.id);
        return annotationPages(entries, namespaces).map(({ parts }) => ({
          params: { ...params, parts: parts || undefined },
        }));
      }),
    )
  ).flat();
}
const authority = await loadStateAuthority(`/${Astro.params.category}/`);
const namespaces = await loadAuthorityNamespaces(authority.id);
const entries = await loadDataAnnotations();
const view = annotationPages(entries, namespaces).find(
  (view) => view.parts === (Astro.params.parts || ""),
);
if (!view) throw new Error("Unknown authority annotation view.");
const base = `${authority.statePath}licensing-authority/data-annotations/`;
---

<PageShell
  title={`${authority.name}: data notes`}
  heading={`${authority.name}: data notes`}
  pagePath={annotationHref(base, view.parts)}
  breadcrumbs={[
    { label: authority.stateName, href: authority.statePath },
    {
      label: authority.name,
      href: `${authority.statePath}licensing-authority/`,
    },
    { label: "Data notes", current: true },
  ]}
>
  <DataAnnotationIndex
    base={base}
    view={view}
    filters={annotationFilters(entries, namespaces)}
  />
</PageShell>
