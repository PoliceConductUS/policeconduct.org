---
import SiteLayout from "#src/layouts/SiteLayout.astro";
import Breadcrumb from "#src/components/Breadcrumb.astro";
import PageHeader from "#src/components/PageHeader.astro";
import { buildWebPage, getSiteUrl } from "#src/lib/structured-data.js";

const pagePath = "/legal-notice/refund/";
const pageDescription =
  "Refund policy for PoliceConduct.org covering refunds, final-sale terms, and refund-related contact information.";
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = new URL(pagePath, siteUrl).toString();
const structuredData = buildWebPage({
  siteUrl,
  pageUrl,
  name: "Refund | PoliceConduct.org",
  description: pageDescription,
});
---

<SiteLayout
  title="Refund | PoliceConduct.org"
  description={pageDescription}
  pagePath={pagePath}
  structuredData={structuredData}
>
  <main id="main" class="civic-index-page">
    <section class="civic-index-page-main">
      <div class="container">
        <Breadcrumb
          items={[
            { label: "Legal Notice", href: "/legal-notice/" },
            { label: "Refund Policy", href: pagePath, current: true },
          ]}
        />
        <PageHeader title="REFUND POLICY" />
        <p>
          <strong>Last updated:</strong> January 14, 2026
        </p>
        <section>
          <h2>REFUNDS</h2>
          <p>All sales are final and no refund will be issued.</p>
        </section>
        <section>
          <h2>QUESTIONS</h2>
          <p>
            If you have any questions concerning our return policy, please
            contact us at:
          </p>
          <p>
            <a href="mailto:support@policeconduct.org"
              >support@policeconduct.org</a
            >
          </p>
        </section>
      </div>
    </section>
  </main>
</SiteLayout>
